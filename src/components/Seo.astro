---
// Shared metadata for Cloudflare-rendered Astro pages.
// hreflang is emitted only for real localized counterparts, and x-default only
// when a specific neutral fallback is provided (the bilingual language gateway).
import { SITE, INDEXABLE, DEFAULT_OG_IMAGE } from '../data/site.js';
const { title, description, lang = 'en', path, alternates = {}, image = DEFAULT_OG_IMAGE, type = 'website', noindex = false, jsonld, xDefault } = Astro.props;
const canonical = SITE + path;
const robots = INDEXABLE && !noindex ? 'index,follow,max-image-preview:large' : 'noindex,nofollow';
const validPair = alternates.en && alternates.es &&
  (path === alternates.en || path === alternates.es || path === xDefault);
const alts = validPair
  ? [{ code: 'en-US', url: alternates.en }, { code: 'es', url: alternates.es }]
  : [];
const imageUrl = image.startsWith('http') ? image : SITE + image;
const safeJson = jsonld ? JSON.stringify(jsonld).replace(/</g, '\\u003c') : null;
---
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{description && <meta name="description" content={description} />}
{alts.map(alt => <link rel="alternate" hreflang={alt.code} href={SITE + alt.url} />)}
{alts.length === 2 && xDefault && <link rel="alternate" hreflang="x-default" href={SITE + xDefault} />}
<link rel="icon" href="/favicon.ico" sizes="16x16" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta property="og:site_name" content="BulldogFrances.com" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={imageUrl} />
{safeJson && <script type="application/ld+json" set:html={safeJson} />}

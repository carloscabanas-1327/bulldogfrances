---
const lang = Astro.params.lang;
const slug = Astro.params.slug;
const dict = {
 en:{home:'Home',back:'Back to bilingual homepage',title:'French Bulldog',desc:'Explore independent guides, practical information and expert-informed resources about French Bulldogs.',cats:{health:'Health guides',nutrition:'Nutrition',training:'Training',puppies:'Puppies','breed-characteristics':'Breed characteristics',history:'History & origins',genetics:'Genetics & breeding','daily-care':'Daily care','news-around-the-world':'News Around the World',store:'Where to Buy',about:'About',directory:'Directory','affiliate-disclosure':'Affiliate disclosure',privacy:'Privacy',terms:'Terms of use'}},
 es:{home:'Inicio',back:'Volver a la portada bilingüe',title:'Bulldog francés',desc:'Explorá guías independientes, información práctica y recursos especializados sobre el bulldog francés.',cats:{health:'Guías de salud',nutrition:'Alimentación',training:'Educación',puppies:'Cachorros','breed-characteristics':'Características de la raza',history:'Historia y orígenes',genetics:'Genética y reproducción','daily-care':'Cuidados cotidianos','news-around-the-world':'Noticias del mundo',store:'Dónde comprar',about:'Acerca de',directory:'Directorio','affiliate-disclosure':'Aviso de afiliación',privacy:'Privacidad',terms:'Términos de uso'}}
};

const t=dict[lang];const title=t.cats[slug];
const demoArticles=[
 {n:'01',title:'In principio creavit Deus caelum et terram.',excerpt:'In principio creavit Deus caelum et terram.',body:"Dixitque Deus: Fiat lux. Et facta est lux. Et vidit Deus lucem quod esset bona; et divisit lucem a tenebris. Appellavitque lucem Diem, et tenebras Noctem. Factumque est vespere et mane, dies unus.",photo:'https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=960&h=520&fit=crop&auto=format&q=80'},
 {n:'02',title:'Terra autem erat inanis et vacua.',excerpt:'Et tenebrae erant super faciem abyssi; et spiritus Dei ferebatur super aquas.',body:"Dixit quoque Deus: Fiat firmamentum in medio aquarum, et dividat aquas ab aquis. Et fecit Deus firmamentum, divisitque aquas quae erant sub firmamento ab his quae erant super firmamentum. Vocavitque Deus firmamentum Caelum.",photo:'https://images.unsplash.com/photo-1500534623283-312aade485b7?w=960&h=520&fit=crop&auto=format&q=80'},
 {n:'03',title:'Dixitque Deus: Fiat lux.',excerpt:'Et facta est lux.',body:"Dixit vero Deus: Congregentur aquae quae sub caelo sunt in locum unum, et appareat arida. Et factum est ita. Et vocavit Deus aridam Terram, congregationesque aquarum appellavit Maria. Et vidit Deus quod esset bonum.",photo:'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=960&h=520&fit=crop&auto=format&q=80'},
 {n:'04',title:'Et vidit Deus lucem quod esset bona.',excerpt:'Et divisit lucem a tenebris.',body:"Et posuit eas in firmamento caeli ut lucerent super terram, et praeessent diei ac nocti, et dividerent lucem ac tenebras. Et vidit Deus quod esset bonum. Et factum est vespere et mane, dies quartus.",photo:'https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=960&h=520&fit=crop&auto=format&q=80'}
];
export function getStaticPaths(){
 const langs=['en','es'];const slugs=['health','nutrition','training','puppies','breed-characteristics','history','genetics','daily-care','news-around-the-world','store','about','directory','affiliate-disclosure','privacy','terms'];
 return langs.flatMap(lang=>slugs.map(slug=>({params:{lang,slug}})));
}
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>{title} | BulldogFrances.com</title>
<style>
:root{color-scheme:only light;font-family:Arial,Helvetica,sans-serif;color:#20212a;background:white}
*{box-sizing:border-box}
body{margin:0;background:#fff;color:#20212a}
a{color:inherit}
header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px clamp(20px,4vw,56px);border-bottom:1px solid #e6e8ec;background:#fff}
.brand{font:700 clamp(16px,2vw,23px)/1.2 Georgia,serif;text-decoration:none}
.switch{display:inline-flex;align-items:center;gap:8px;padding:9px 15px;border:1px solid #d9dce4;border-radius:99px;text-decoration:none;font-weight:700;white-space:nowrap}
.switch:hover,.tiles a:hover{background:#f1f5fb}
.hero{background:#f7f8fc;padding:22px clamp(20px,5vw,72px) 24px}
.eyebrow{font-size:13px;font-weight:700;letter-spacing:.14em;color:#626b7a;text-transform:uppercase;margin:0 0 7px}
h1{font:700 clamp(32px,3.5vw,46px)/1.12 Georgia,serif;letter-spacing:-.025em;margin:0 0 9px}
.hero .desc{font-size:clamp(15px,1.35vw,17px);line-height:1.42;max-width:760px;margin:0;color:#444c5b}
.content{padding:clamp(25px,3vw,38px) clamp(20px,5vw,72px) 60px}
.sample-label{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#657084;font-weight:700;margin:0 0 14px}
.article-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px;margin-bottom:38px}
.article-card{border:1px solid #e0e4ea;border-radius:15px;overflow:hidden;background:#fff}
.article-art{height:150px;background:linear-gradient(135deg,#e8eef7,#f7f9fd);display:flex;align-items:center;justify-content:center;color:#697a96;font:700 30px Georgia,serif}
.article-art img{width:100%;height:100%;object-fit:cover;display:block}.article-body .article-extra{margin-top:12px}.article-body{padding:19px 22px 23px}.article-body h3{font:700 clamp(20px,2vw,27px)/1.18 Georgia,serif;margin:0 0 12px}.article-body p{font-size:16px;line-height:1.5;color:#4e5969;margin:0}
.article-note{font-size:13px;color:#647084;margin:0 0 25px}
.lang-tag{font:700 10px Arial,sans-serif;letter-spacing:.03em;color:#59677b;vertical-align:middle}
.flag{font-size:14px;vertical-align:middle}
h2{font:700 clamp(27px,3vw,40px)/1.16 Georgia,serif;margin:0 0 22px}
.tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}
.tiles a{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:88px;padding:20px;border:1px solid #e0e4ea;border-radius:14px;background:#fff;text-decoration:none;font-size:18px;font-weight:700}
.tiles a span{color:#697386}
footer{border-top:1px solid #e6e8ec;padding:25px clamp(20px,5vw,72px);color:#555e6b;font-size:14px}
@media(max-width:700px){.article-grid{grid-template-columns:1fr}.article-art{height:120px}.tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:480px){header{padding:14px 17px}.brand{font-size:16px}.switch{padding:9px 11px;font-size:14px}.tiles{grid-template-columns:1fr}.tiles a{min-height:75px}.hero{padding:22px 20px 24px}}
</style>
</head>
<body>
<header><a class="brand" href={'/'+lang+'/'}>BULLDOGFRANCES.COM</a><a class="switch" href={'/'+(lang==='en'?'es':'en')+'/'+slug+'/'}><span class="flag" aria-hidden="true">{lang==='en'?'🇪🇸':'🇬🇧'}</span><span>{lang==='en'?'ES Español →':'EN English →'}</span></a></header>
<main>
<section class="hero"><p class="eyebrow">{lang==='en'?'French Bulldog · English edition':'Bulldog francés · Edición en español'}</p><h1>{title}</h1><p class="desc">{t.desc}</p></section>
<section class="content">
<p class="sample-label">{lang==='en'?'Layout demonstration · Genesis 1 in Latin':'Demostración visual · Génesis 1 en latín'}</p>
<div class="article-grid">{demoArticles.map(a=><article class="article-card"><div class="article-art"><img src={a.photo} alt="Paisaje ilustrativo de muestra" loading="lazy" /></div><div class="article-body"><h3>{a.title}</h3><p>{a.excerpt}</p><p class="article-extra">{a.body}</p></div></article>)}</div>
<p class="article-note">{lang==='en'?'Sample text for layout testing; not French Bulldog editorial articles.':'Textos de muestra para probar el diseño; no son artículos editoriales sobre bulldogs franceses.'}</p>
<h2>{lang==='en'?'Explore more topics':'Explorar más temas'}</h2><nav class="tiles" aria-label={lang==='en'?'Related topics':'Temas relacionados'}>{Object.entries(t.cats).filter(([k])=>!['about','directory','affiliate-disclosure','privacy','terms',slug].includes(k)).map(([k,v])=><a href={'/'+lang+'/'+k+'/'}>{v}<span aria-hidden="true">→</span></a>)}</nav></section>
</main>
<footer>© {new Date().getFullYear()} BulldogFrances.com · {lang==='en'?'Knowledge · Care · Community':'Conocimiento · Cuidado · Comunidad'}</footer>
</body></html>
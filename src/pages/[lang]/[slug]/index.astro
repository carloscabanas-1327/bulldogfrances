.tiles a span{color:#697386}
footer{border-top:1px solid #e6e8ec;padding:25px clamp(20px,5vw,72px);color:#555e6b;font-size:14px}
@media(max-width:700px){.article-grid{grid-template-columns:1fr}.article-art{height:120px}.tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:480px){header{padding:14px 17px}.brand{font-size:16px}.switch{padding:9px 11px;font-size:14px}.tiles{grid-template-columns:1fr}.tiles a{min-height:75px}.hero{padding:22px 20px 24px}}

/* Shared editorial shell — identical across language and category pages */
:root{color-scheme:only light!important;--ink:#202532;--muted:#4e5969;--edge:#e0e4ea}
body{font-family:Arial,Helvetica,sans-serif!important;font-size:16px!important;line-height:1.5!important}
header{min-height:74px!important;padding:12px clamp(18px,4vw,56px)!important;display:flex!important;align-items:center!important;justify-content:space-between!important;background:#fff!important;color:var(--ink)!important}
header .logo,header .brand{font:700 clamp(17px,2vw,23px)/1.2 Georgia,serif!important;letter-spacing:-.02em!important;white-space:nowrap!important;text-decoration:none!important;color:var(--ink)!important}
header .switch{display:inline-flex!important;align-items:center!important;gap:7px!important;padding:9px 13px!important;border:1px solid #d9dce4!important;border-radius:99px!important;background:#fff!important;color:var(--ink)!important;font:700 14px/1.2 Arial,sans-serif!important;white-space:nowrap!important;text-decoration:none!important}
header .switch .flag{font-size:14px!important;line-height:1!important;display:inline-block!important}
.hero{padding:22px clamp(20px,5vw,72px) 24px!important;background:#f5f8fc!important;color:var(--ink)!important}
.hero h1{font:700 clamp(32px,3.5vw,46px)/1.12 Georgia,serif!important;letter-spacing:-.025em!important;margin:7px 0 9px!important;color:var(--ink)!important}
.hero .intro,.hero .desc{font:400 clamp(15px,1.35vw,17px)/1.42 Arial,sans-serif!important;color:#444c5b!important;margin:0!important;max-width:790px!important}
.hero .kicker,.hero .eyebrow{font:700 12px/1.3 Arial,sans-serif!important;letter-spacing:.12em!important;color:#626b7a!important;text-transform:uppercase!important;margin:0!important}
.content{max-width:1320px!important;margin:auto!important;padding:30px clamp(20px,5vw,72px) 65px!important}
.content h2{font:700 clamp(25px,2.6vw,35px)/1.16 Georgia,serif!important}
footer{background:#fff!important;color:var(--ink)!important;border-top:1px solid var(--edge)!important}
@media(max-width:540px){header{min-height:62px!important;padding:10px 14px!important;gap:8px!important}header .logo,header .brand{font-size:clamp(14px,3.7vw,18px)!important}header .switch{font-size:12px!important;padding:8px 9px!important}.hero{padding:20px 18px 22px!important}.hero h1{font-size:32px!important}.content{padding:24px 16px 48px!important}}

/* Portrait-friendly editorial image ratio and one clean summary */
.article-art{height:auto!important;aspect-ratio:16/10!important;overflow:hidden!important}
.article-art img{width:100%!important;height:100%!important;object-fit:cover!important;object-position:center center!important}
.article-body .article-summary{display:-webkit-box!important;-webkit-box-orient:vertical!important;-webkit-line-clamp:4!important;line-clamp:4!important;overflow:hidden!important;font-size:16px!important;line-height:1.5!important;margin:0!important}
.article-body h3{font-size:clamp(20px,2vw,27px)!important}
@media(max-width:700px){.article-art{aspect-ratio:4/3!important}}
.footer-nav{display:flex;flex-wrap:wrap;gap:18px;justify-content:center;margin:16px 0}.footer-nav a{color:inherit}footer{text-align:center!important}

/* Consistent rounded imagery and universal share control */
img:not(.flag){border-radius:14px} .share-dock{position:fixed;right:18px;bottom:22px;z-index:1000;font-family:Arial,sans-serif}.share-toggle{border:1px solid #b9c5d6;border-radius:999px;background:#fff;color:#27354a;padding:12px 18px;font:700 15px Arial,sans-serif;box-shadow:0 3px 18px #0002;cursor:pointer}.share-menu{position:absolute;bottom:calc(100% + 9px);right:0;width:220px;background:#fff;color:#27354a;border:1px solid #d5dce7;border-radius:14px;box-shadow:0 10px 32px #0002;padding:8px;display:none}.share-dock[data-open="true"] .share-menu{display:block}.share-menu a,.share-menu button{display:block;width:100%;text-align:left;background:transparent;border:0;color:#27354a;text-decoration:none;font:15px Arial,sans-serif;padding:11px 13px;border-radius:8px;cursor:pointer}.share-menu a:hover,.share-menu button:hover{background:#f0f4fa}@media(max-width:600px){.share-dock{right:12px;bottom:80px}.share-toggle{padding:10px 13px;font-size:13px}}
.share-dock,.sharebox{position:static!important;box-shadow:none!important}.inline-share{position:relative;display:inline-block;flex-shrink:0}.inline-share summary{cursor:pointer;border:1px solid #ccd5e1;border-radius:25px;padding:6px 10px;background:#fff;color:#34445b;font:600 12px Arial;list-style:none}.inline-share .links{position:absolute;right:0;top:100%;min-width:175px;background:#fff;border:1px solid #ccd5e1;border-radius:10px;padding:8px;z-index:30;box-shadow:0 6px 20px #0002}.inline-share .links a{display:block;padding:8px;color:#34445b;text-decoration:none;font:14px Arial}.heading-share{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.heading-share h1,.heading-share h3{flex:1;min-width:0}
/* Two editorial cards per desktop row; one natural-height card on mobile */
.article-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:24px!important;align-items:start}
.article-card{display:block!important;min-height:0!important;overflow:visible!important;border:0!important;border-bottom:1px solid #dfe4eb!important;border-radius:0!important;padding-bottom:22px!important}

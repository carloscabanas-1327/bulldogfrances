const lang = Astro.params.lang;
const slug = Astro.params.slug;
const dict = {
 en:{home:'Home',back:'Back to bilingual homepage',title:'French Bulldog',desc:'Explore independent guides, practical information and expert-informed resources about French Bulldogs.',cats:{health:'Health guides',nutrition:'Nutrition',training:'Training',puppies:'Puppies','breed-characteristics':'Breed characteristics',history:'History & origins',genetics:'Genetics & breeding','daily-care':'Daily care','news-around-the-world':'News Around the World',store:'Where to Buy',about:'About',contact:'Contact',directory:'Directory','affiliate-disclosure':'Affiliate disclosure','editorial-policy':'Editorial policy',privacy:'Privacy',terms:'Terms of use'}},
 es:{home:'Inicio',back:'Volver a la portada bilingüe',title:'Bulldog francés',desc:'Explorá guías independientes, información práctica y recursos especializados sobre el bulldog francés.',cats:{health:'Guías de salud',nutrition:'Alimentación',training:'Educación',puppies:'Cachorros','breed-characteristics':'Características de la raza',history:'Historia y orígenes',genetics:'Genética y reproducción','daily-care':'Cuidados cotidianos','news-around-the-world':'Noticias del mundo',store:'Dónde comprar',about:'Acerca de',contact:'Contacto',directory:'Directorio','affiliate-disclosure':'Aviso de afiliación','editorial-policy':'Política editorial',privacy:'Privacidad',terms:'Términos de uso'}}
};

const t=dict[lang];const title=t.cats[slug];
const legalPages = {"en":{"contact":[["Get in touch","For editorial questions, corrections, partnership inquiries, affiliate programs or privacy requests, write to info@bulldogfrances.com."],["Email availability","This address is being configured. Until mail delivery is verified, messages sent to it may not reach us. No contact form or newsletter subscription is offered on this page."]],"about":[["Who we are","BulldogFrances.com is an independent, bilingual editorial website dedicated to French Bulldogs. The site publishes educational resources about health, nutrition, behavior, daily care, breed history and responsible ownership."],["Editorial purpose","Our goal is to help readers make informed decisions using clear explanations and reputable sources. Content is informational and is not a substitute for individualized veterinary advice."],["Independence and funding","The website may earn revenue from advertising, sponsorships or affiliate relationships. Commercial arrangements do not guarantee favorable editorial coverage. Paid relationships should be identified where they occur."],["Corrections and accountability","We aim to correct material errors, distinguish evidence from opinion, and update information when better evidence becomes available. Veterinary review is not implied unless expressly credited on a specific article."],["Site operator and contact","BulldogFrances.com is the public-facing name of this publication. The responsible legal operator and a dedicated contact address must be published before commercial applications or launch; they are not yet stated here."]],"privacy":[["Scope and responsible party","This policy explains how personal information may be handled when visiting BulldogFrances.com. The website’s legal controller and privacy contact details must be completed before public launch."],["Information and purposes","Depending on features actually enabled, technical logs may include IP address, browser, device, request time and visited pages for hosting, security and troubleshooting. If you contact the publisher, the information you choose to provide may be used to respond. No account registration or newsletter collection is represented as active here."],["Hosting and service providers","The website is being developed using GitHub and Cloudflare Pages. Hosting infrastructure may process technical request information. Third-party services embedded in future pages, such as analytics, videos, advertisements or affiliate tracking, must be identified in this policy before activation."],["Cookies and tracking","We do not claim that all pages are cookie-free. Essential infrastructure functions may operate, and optional analytics, advertising or affiliate cookies must be documented and, where required, subject to valid consent before use. Readers can manage cookies in their browser."],["Affiliate links and external websites","Following an affiliate or external link may take you to a separate website with its own privacy practices. Any applicable affiliate tracking should be disclosed at the link or in the relevant article."],["Retention and security","Technical and correspondence data should be kept only as long as reasonably necessary for their stated purposes, subject to provider retention settings and applicable law. Reasonable security safeguards are intended, but no internet service can guarantee absolute security."],["Your rights and international transfers","Depending on applicable law, you may have rights to access, correct, delete, restrict or object to processing, or withdraw consent. Hosting or third-party providers may process information in other countries. A working privacy contact and any required transfer notices must be added before launch."],["Changes","This policy will be updated when the site’s services, vendors or processing practices change. Last revised: October 28, 2026."]],"terms":[["Acceptance and permitted use","By using BulldogFrances.com you agree to use the site lawfully and not interfere with its operation. If you do not agree, discontinue use."],["Educational and veterinary disclaimer","Content is provided for general educational purposes only, not as diagnosis, treatment, emergency guidance or a professional veterinary-client relationship. Consult a licensed veterinarian for individual animal health concerns. In an emergency, seek immediate veterinary care."],["Accuracy and updates","We strive for accuracy but cannot guarantee that every article is complete, current or suitable for every dog. Information may change as veterinary evidence and regulations evolve."],["Intellectual property","Original text, design and branding are protected as applicable. Third-party images, marks and referenced material remain subject to their owners’ rights. Do not republish substantial content without permission or an applicable legal exception."],["External links and commerce","Links may lead to independent websites. We do not control third-party products, availability, policies, purchases or claims. Affiliate compensation may apply as separately disclosed."],["No warranties and limitation","The site is provided on an as-available basis to the extent permitted by applicable law. Nothing in these terms excludes rights or liability that cannot legally be excluded."],["Changes and governing law","Terms may be revised prospectively. Applicable mandatory consumer and privacy protections remain in force. The operator’s legal identity, contact details and jurisdiction must be confirmed before public launch. Last revised: October 28, 2026."]],"affiliate-disclosure":[["How affiliate links work","BulldogFrances.com may participate in affiliate programs. If you follow a qualifying affiliate link and make a purchase, we may receive a commission at no additional cost to you. Compensation and eligibility depend on each merchant’s terms."],["Clear disclosure near recommendations","Where a page includes compensated product recommendations or affiliate links, we aim to identify that relationship clearly and conspicuously near the relevant content, not only on this policy page. Links may use rel=\"sponsored nofollow\" where appropriate."],["Editorial independence","Affiliate participation does not mean a merchant endorses our content or that we endorse every product it sells. Product coverage should consider suitability, evidence, safety and readers’ needs. We do not promise that every recommendation has been independently tested."],["Advertising and sponsorship","Paid placements, sponsorships and complimentary products, if accepted, should be labeled in the relevant content. Brand names and trademarks belong to their respective owners."],["Program status","This notice describes potential monetization. It does not assert that BulldogFrances.com has been accepted into any specific merchant program. Last revised: October 28, 2026."]],"editorial-policy":[["Mission and standards","We publish accessible, evidence-informed information about French Bulldogs for readers in English and Spanish. Accuracy, animal welfare, clarity and editorial independence take priority over commercial interests."],["Sources and verification","Health and nutrition claims should be checked against appropriate veterinary guidance, peer-reviewed research and reliable primary sources where possible. We distinguish established findings from uncertainty and avoid unsupported promises."],["Medical review and authorship","Articles must not be described as veterinarian-reviewed unless a qualified reviewer has actually reviewed the specific version and is credited. Drafts and previews are not equivalent to approved medical content."],["Updates and corrections","We correct substantive errors, review outdated recommendations and aim to display meaningful revision information on articles. Readers should not rely on an old article as a substitute for current veterinary care."],["Commercial separation","Affiliate relationships, sponsorships and advertising must be disclosed. Merchants do not automatically receive editorial approval or control over conclusions."],["Images and translation","Images should be properly licensed or owned and not presented as evidence of events they do not depict. Translations should preserve factual meaning and safety guidance across languages."]]},"es":{"contact":[["Escribinos","Para consultas editoriales, correcciones, propuestas comerciales, programas de afiliación o solicitudes de privacidad, escribí a info@bulldogfrances.com."],["Disponibilidad del correo","Esta dirección se encuentra en configuración. Hasta verificar la recepción, los mensajes enviados podrían no llegar. Esta página no ofrece formulario ni suscripción a boletines."]],"about":[["Quiénes somos","BulldogFrances.com es una publicación editorial independiente y bilingüe dedicada al bulldog francés. Publica recursos educativos sobre salud, alimentación, conducta, cuidados, historia de la raza y tenencia responsable."],["Propósito editorial","Buscamos ayudar a los lectores a tomar decisiones informadas mediante explicaciones claras y fuentes confiables. El contenido es informativo y no sustituye la atención veterinaria individual."],["Independencia y financiación","El sitio podrá obtener ingresos mediante publicidad, patrocinios o afiliación comercial. Esas relaciones no garantizan una cobertura editorial favorable y deberán identificarse cuando existan."],["Correcciones y responsabilidad","Procuramos corregir errores relevantes, diferenciar pruebas de opiniones y actualizar información ante nueva evidencia. Ningún artículo debe considerarse revisado por veterinarios salvo indicación expresa y verificable."],["Responsable y contacto","BulldogFrances.com es el nombre público de la publicación. Antes del lanzamiento comercial deben incorporarse la identidad legal del responsable y un medio de contacto operativo; todavía no se consignan aquí."]],"privacy":[["Alcance y responsable","Esta política explica el posible tratamiento de datos personales al visitar BulldogFrances.com. Antes del lanzamiento público deben completarse la identidad del responsable y el contacto de privacidad."],["Datos y finalidades","Según las funciones habilitadas, los registros técnicos pueden incluir dirección IP, navegador, dispositivo, fecha y páginas visitadas para alojamiento, seguridad y diagnóstico. Si escribís al responsable, los datos que proporciones podrán utilizarse para responder. No se declara activo un sistema de cuentas ni de boletines."],["Alojamiento y proveedores","El sitio se desarrolla mediante GitHub y Cloudflare Pages. La infraestructura de alojamiento puede procesar datos técnicos de solicitudes. Antes de activar analítica, videos, publicidad o seguimiento de afiliación se deberán identificar los servicios correspondientes."],["Cookies y seguimiento","No afirmamos que todas las páginas carezcan de cookies. Pueden existir funciones técnicas necesarias y, si se incorporan cookies opcionales de analítica, publicidad o afiliación, deberán informarse y solicitar consentimiento cuando corresponda. Podés gestionar cookies desde el navegador."],["Enlaces de afiliados y sitios externos","Al seguir enlaces externos o de afiliación podés ingresar a sitios con políticas propias. El seguimiento comercial aplicable deberá informarse junto al enlace o contenido relevante."],["Conservación y seguridad","Los datos técnicos y comunicaciones deberían conservarse solo durante el tiempo necesario para sus finalidades, según la configuración de proveedores y la ley aplicable. Se procurarán medidas razonables de seguridad, sin prometer seguridad absoluta."],["Derechos y transferencias internacionales","Según la legislación aplicable, podés solicitar acceso, rectificación, supresión, oposición u otras medidas, y retirar consentimientos. Los proveedores pueden tratar datos en otros países. Antes del lanzamiento se incorporará un contacto efectivo y la información adicional requerida."],["Modificaciones","Esta política se actualizará cuando cambien los servicios, proveedores o tratamientos. Última revisión: 28 de octubre de 2026."]],"terms":[["Aceptación y uso permitido","Al utilizar BulldogFrances.com aceptás usar el sitio lícitamente y no interferir con su funcionamiento. Si no estás de acuerdo, dejá de utilizarlo."],["Información educativa y advertencia veterinaria","Los contenidos son educativos y generales; no constituyen diagnóstico, tratamiento, indicación de urgencia ni relación profesional veterinaria. Consultá a un veterinario matriculado para casos individuales y acudí de inmediato ante emergencias."],["Exactitud y actualizaciones","Buscamos ofrecer información correcta, pero no garantizamos que cada artículo sea completo, actual o adecuado para todos los perros. Las recomendaciones pueden cambiar con la evidencia y la normativa."],["Propiedad intelectual","Los textos, el diseño y la marca originales están protegidos según corresponda. Las imágenes, marcas y materiales de terceros conservan sus respectivos derechos. No reproduzcas contenido sustancial sin autorización o excepción legal aplicable."],["Enlaces externos y comercio","Los enlaces pueden conducir a sitios independientes. No controlamos productos, disponibilidad, políticas, compras ni afirmaciones de terceros. Puede existir remuneración por afiliación, informada por separado."],["Garantías y responsabilidad","El sitio se ofrece según su disponibilidad y dentro de los límites permitidos por la ley. Estas condiciones no excluyen derechos ni responsabilidades que legalmente no puedan excluirse."],["Cambios y legislación aplicable","Las condiciones podrán actualizarse hacia el futuro. Se respetarán las normas imperativas de consumo y privacidad. Antes del lanzamiento deberán confirmarse la identidad legal, el contacto y la jurisdicción del responsable. Última revisión: 28 de octubre de 2026."]],"affiliate-disclosure":[["Cómo funcionan los enlaces de afiliación","BulldogFrances.com podrá participar en programas de afiliación. Si seguís un enlace elegible y comprás, podríamos recibir una comisión sin costo adicional para vos. Las condiciones dependen de cada merchant."],["Avisos visibles junto a las recomendaciones","Cuando una página incluya recomendaciones remuneradas o enlaces de afiliación, procuraremos informar la relación de manera clara y visible cerca del contenido correspondiente, no únicamente en esta página. Los enlaces podrán utilizar rel=\"sponsored nofollow\" según corresponda."],["Independencia editorial","La afiliación no implica que un merchant avale nuestro contenido ni que recomendemos todos sus productos. La selección debería considerar idoneidad, evidencia, seguridad y necesidades del lector. No afirmamos haber probado personalmente todos los productos."],["Publicidad y patrocinios","Los espacios pagos, patrocinios y productos cedidos, si se aceptan, deberán identificarse en el contenido. Las marcas pertenecen a sus respectivos titulares."],["Estado de los programas","Este aviso describe formas posibles de monetización; no afirma que BulldogFrances.com haya sido aceptado por un merchant determinado. Última revisión: 28 de octubre de 2026."]],"editorial-policy":[["Misión y principios","Publicamos información accesible y fundamentada sobre el bulldog francés en inglés y español. Priorizamos exactitud, bienestar animal, claridad e independencia editorial frente a intereses comerciales."],["Fuentes y verificación","Las afirmaciones de salud y nutrición deben contrastarse con orientación veterinaria apropiada, investigaciones científicas y fuentes primarias confiables cuando sea posible. Distinguimos hallazgos establecidos de incertidumbres y evitamos promesas infundadas."],["Revisión médica y autoría","No debe describirse un artículo como revisado por veterinarios salvo que un profesional calificado haya revisado esa versión y figure acreditado. Los borradores y demostraciones no equivalen a contenido médico aprobado."],["Actualizaciones y correcciones","Corregimos errores sustanciales, revisamos recomendaciones desactualizadas y procuramos informar revisiones importantes. Un artículo antiguo no sustituye la atención veterinaria actual."],["Separación comercial","Las afiliaciones, los patrocinios y la publicidad deben declararse. Los merchants no obtienen aprobación editorial automática ni control sobre las conclusiones."],["Imágenes y traducciones","Las imágenes deben tener derechos de uso adecuados y no presentarse como prueba de hechos que no representan. Las traducciones deben preservar el sentido factual y las advertencias de seguridad."]]}};
const isLegal = ['about','contact','privacy','terms','affiliate-disclosure','editorial-policy'].includes(slug);
const demoArticles=[
 {n:'01',title:'In principio creavit Deus caelum et terram.',excerpt:'In principio creavit Deus caelum et terram.',body:"Dixitque Deus: Fiat lux. Et facta est lux. Et vidit Deus lucem quod esset bona; et divisit lucem a tenebris. Appellavitque lucem Diem, et tenebras Noctem. Factumque est vespere et mane, dies unus.",photo:'https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=960&h=520&fit=crop&auto=format&q=80'},
 {n:'02',title:'Terra autem erat inanis et vacua.',excerpt:'Et tenebrae erant super faciem abyssi; et spiritus Dei ferebatur super aquas.',body:"Dixit quoque Deus: Fiat firmamentum in medio aquarum, et dividat aquas ab aquis. Et fecit Deus firmamentum, divisitque aquas quae erant sub firmamento ab his quae erant super firmamentum. Vocavitque Deus firmamentum Caelum.",photo:'https://images.unsplash.com/photo-1500534623283-312aade485b7?w=960&h=520&fit=crop&auto=format&q=80'},
 {n:'03',title:'Dixitque Deus: Fiat lux.',excerpt:'Et facta est lux.',body:"Dixit vero Deus: Congregentur aquae quae sub caelo sunt in locum unum, et appareat arida. Et factum est ita. Et vocavit Deus aridam Terram, congregationesque aquarum appellavit Maria. Et vidit Deus quod esset bonum.",photo:'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=960&h=520&fit=crop&auto=format&q=80'},
 {n:'04',title:'Et vidit Deus lucem quod esset bona.',excerpt:'Et divisit lucem a tenebris.',body:"Et posuit eas in firmamento caeli ut lucerent super terram, et praeessent diei ac nocti, et dividerent lucem ac tenebras. Et vidit Deus quod esset bonum. Et factum est vespere et mane, dies quartus.",photo:'https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=960&h=520&fit=crop&auto=format&q=80'}
];
export function getStaticPaths(){
 const langs=['en','es'];const slugs=['health','nutrition','training','puppies','breed-characteristics','history','genetics','daily-care','news-around-the-world','store','about','contact','directory','affiliate-disclosure','privacy','terms','editorial-policy','contact'];
 return langs.flatMap(lang=>slugs.map(slug=>({params:{lang,slug}})));
}
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>{title} | BulldogFrances.com</title>
<style is:global>:root{font-family:Arial,sans-serif;color:#192b3b}*{box-sizing:border-box}body{margin:0}img{max-width:100%}header,main,footer{width:min(1200px,calc(100% - 32px));margin:auto}header{min-height:68px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ddd}.brand{font:700 22px Georgia,serif;text-decoration:none}.switch{display:flex;gap:8px;align-items:center;padding:9px;border:1px solid #ddd;border-radius:25px;text-decoration:none}.hero{background:#f3f7fc;padding:32px}.eyebrow,.sample-label{font-size:12px;text-transform:uppercase;letter-spacing:.1em}h1{font:700 clamp(30px,4vw,46px) Georgia,serif;margin:8px 0}.content{padding:32px 20px 60px}.legal-document{max-width:780px;margin:auto}.legal-section{margin-bottom:28px}.legal-section h2{font:700 clamp(23px,3vw,30px) Georgia,serif;margin:0 0 12px}.legal-section p{font-size:16px;line-height:1.7}.article-grid,.tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.article-card,.tiles a{min-width:0;border:1px solid #ddd;border-radius:14px;overflow:hidden}.article-art img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}.article-body{padding:16px}.article-body h3{font:700 24px Georgia,serif}.article-body p{line-height:1.5}.heading-share{display:flex;justify-content:space-between;gap:12px}.inline-share{position:relative}.inline-share .links{position:absolute;right:0;z-index:5;background:white;padding:12px;border:1px solid #ddd}.inline-share .links a{display:block;padding:5px}.footer-nav,footer nav{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}footer{border-top:1px solid #ddd;padding:30px;text-align:center}@media(max-width:650px){header,main,footer{width:calc(100% - 20px)}.hero{padding:22px}.content{padding:22px 10px 45px}.article-grid,.tiles{grid-template-columns:1fr}.brand{font-size:17px}}
/* Social sharing: accessible compact button and branded destinations. */
.inline-share{position:relative;flex:0 0 auto;z-index:2}
.inline-share[open]{z-index:30}
.inline-share>summary{list-style:none;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:42px;min-height:38px;padding:8px 12px;border:1px solid #c9d8e6;border-radius:999px;background:#f4f8fc;color:#214968;font:700 13px Arial,sans-serif;cursor:pointer;box-shadow:0 2px 7px #172e4412}
.inline-share>summary::-webkit-details-marker{display:none}
.inline-share>summary::before{content:'↗';font-size:19px;line-height:1}
.inline-share>summary:hover,.inline-share>summary:focus-visible{background:#e4f0fb;border-color:#7fa7c8;outline-offset:2px}
.inline-share .links{position:absolute;top:calc(100% + 8px);right:0;left:auto;z-index:50;display:grid;gap:3px;width:190px;min-width:190px;padding:9px;border:1px solid #dce4ec;border-radius:13px;background:#fff;box-shadow:0 12px 32px #15293c30}
.inline-share .links a{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:8px;color:#203245;font:600 14px Arial,sans-serif;text-decoration:none;cursor:pointer}
.inline-share .links a:hover,.inline-share .links a:focus-visible{background:#f1f5fa}
.inline-share .social-icon{display:grid;place-items:center;flex:0 0 28px;width:28px;height:28px;border-radius:50%;font:700 16px Arial,sans-serif;color:#fff;background:#506579;margin:0}
.inline-share .social-icon svg{display:block;width:17px;height:17px}
.inline-share .fb-icon{background:#1877f2}.inline-share .wa-icon{background:#25d366}.inline-share .pin-icon{background:#bd081c}.inline-share .mail-icon{background:#607d8b}.inline-share .tw-icon{background:#111}.inline-share .copy-icon,.inline-share .link-icon{background:#527fa3}
.article-card:has(.inline-share[open]){overflow:visible;position:relative;z-index:20}
.article-card:has(.inline-share[open]) .article-art img{border-radius:13px 13px 0 0}
@media(max-width:600px){.inline-share .links{width:180px;min-width:180px}}

/* Restore original discreet icon-only share control; keep colored share links. */
.inline-share>summary{width:38px;min-width:38px;height:38px;min-height:38px;padding:0;border-radius:50%;font-size:0;gap:0;background:#fff}
.inline-share>summary::before{content:'↗';font:700 20px/1 Arial,sans-serif}

/* Share control matches reference: subtle outlined pill, blue network icon and text. */
.inline-share>summary{display:inline-flex;align-items:center;justify-content:center;gap:9px;width:auto;min-width:126px;height:48px;min-height:48px;padding:0 18px;border:1px solid #d8dedb;border-radius:999px;background:#fff;color:#155a93;font:400 20px/1.2 Arial,Helvetica,sans-serif;box-shadow:none}
.inline-share>summary::before{content:'♧';display:inline-block;font-size:0;width:21px;height:21px;background:currentColor;mask:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22%3E%3Ccircle cx=%2218%22 cy=%225%22 r=%223%22 fill=%22none%22 stroke=%22black%22 stroke-width=%222%22/%3E%3Ccircle cx=%226%22 cy=%2212%22 r=%223%22 fill=%22none%22 stroke=%22black%22 stroke-width=%222%22/%3E%3Ccircle cx=%2218%22 cy=%2219%22 r=%223%22 fill=%22none%22 stroke=%22black%22 stroke-width=%222%22/%3E%3Cpath d=%22M9 11l6-4M9 14l6 4%22 fill=%22none%22 stroke=%22black%22 stroke-width=%222%22/%3E%3C/svg%3E') center/contain no-repeat}
.inline-share>summary:hover,.inline-share>summary:focus-visible{background:#f7fafc;border-color:#aac2d4}

/* Fine alignment: language switch 2px to the right. */
header .switch{transform:translateX(2px)}
</style>
<link rel="stylesheet" href="/search.css"><link rel="stylesheet" href="/site-header.css"></head>
<body>
<header><a class="brand" href={'/'+lang+'/'}>BULLDOGFRANCES.COM</a><a class="switch" href={'/'+(lang==='en'?'es':'en')+'/'+slug+'/'}><img class="language-flag" src={lang==="en"?"/flags/es.svg":"/flags/us.svg"} alt="" width="25" height="17" /><span>{lang==='en'?'Español →':'English →'}</span></a></header>
<main>
<section class="hero"><p class="eyebrow">{lang==='en'?'French Bulldog · English edition':'Bulldog francés · Edición en español'}</p><h1>{title}</h1>{!isLegal && <p class="desc">{t.desc}</p>}</section>

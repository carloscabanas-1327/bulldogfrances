<body>
<header><a class="brand" href={'/'+lang+'/'}>BULLDOGFRANCES.COM</a><a class="switch" href={'/'+(lang==='en'?'es':'en')+'/'+slug+'/'}><span class="flag" aria-hidden="true">{lang==='en'?'🇪🇸':'🇬🇧'}</span><span>{lang==='en'?'ES Español →':'EN English →'}</span></a>{!['privacy','terms','affiliate-disclosure','about'].includes(slug)&&}</header>
<main>
<section class="hero"><p class="eyebrow">{lang==='en'?'French Bulldog · English edition':'Bulldog francés · Edición en español'}</p><h1>{title}</h1><p class="desc">{t.desc}</p></section>
<section class="content">
{slug==='nutrition'?<><p class="sample-label">{lang==='en'?'Nutrition · Four editorial previews':'Alimentación · Cuatro artículos de muestra'}</p><div class="article-grid">{[["how-much-should-a-french-bulldog-eat","How Much Should a French Bulldog Eat?","¿Cuánto debe comer un bulldog francés?","La ración depende del peso ideal, la edad, la actividad y la condición corporal. Aprendé a medir porciones y ajustar la alimentación sin improvisar.","https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=960&h=650&fit=crop&auto=format&q=85"],["best-food-for-french-bulldogs","Choosing Food for a French Bulldog","Cómo elegir alimento para un bulldog francés","Qué buscar en una dieta completa y equilibrada, cómo evaluar su calidad y por qué las etiquetas comerciales no cuentan toda la historia.","https://images.unsplash.com/photo-1582798358481-d199fb7347bb?w=960&h=650&fit=crop&auto=format&q=85"],["french-bulldog-food-allergies","Food Allergies in French Bulldogs","Alergias alimentarias en el bulldog francés","La picazón no siempre se debe a la comida. Conocé cómo se investiga una posible alergia alimentaria con supervisión veterinaria.","https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=960&h=650&fit=crop&auto=format&q=85"],["safe-treats-for-french-bulldogs","Safe Treats and Foods to Avoid","Premios seguros y alimentos que deben evitarse","Los premios también aportan calorías. Repasamos opciones prudentes, alimentos tóxicos y medidas para evitar atragantamientos.","https://images.unsplash.com/photo-1601758228041-f3b2795255f1?w=960&h=650&fit=crop&auto=format&q=85"]].map(a=><div class="article-card" data-href={'/'+lang+'/nutrition/'+a[0]+'/'} style="text-decoration:none;color:inherit"><a class="article-art" href={"/"+lang+"/nutrition/"+a[0]+"/"} aria-label={lang==="en"?a[1]:a[2]}><img src={a[4]} alt={lang==='en'?'Nutrition editorial illustration':'Imagen editorial de alimentación'} loading="lazy" /></a><div class="article-body"><div class="heading-share"><h3><a href={'/'+lang+'/nutrition/'+a[0]+'/'}>{lang==='en'?a[1]:a[2]}</a></h3><details class="inline-share" data-url={'/'+lang+'/nutrition/'+a[0]+'/'} data-title={lang==='en'?a[1]:a[2]}><summary aria-label="Compartir / Share" title="Compartir / Share">Share</summary><div class="links"><a class="copy" href="#"><span class="social-icon copy-icon" aria-hidden="true">🔗</span>Copy link</a><a class="fb" target="_blank" rel="noopener"><span class="social-icon fb-icon" aria-hidden="true">f</span>Facebook</a><a class="wa" target="_blank" rel="noopener"><span class="social-icon wa-icon" aria-hidden="true">◉</span>WhatsApp</a><a class="mail"><span class="social-icon mail-icon" aria-hidden="true">✉</span>Email</a><a class="pin" target="_blank" rel="noopener"><span class="social-icon pin-icon" aria-hidden="true">p</span>Pinterest</a><a class="tw" target="_blank" rel="noopener"><span class="social-icon tw-icon" aria-hidden="true">𝕏</span>X</a></div></details></div><p class="article-summary">{a[3]}</p><p class="read-article" style="margin-top:14px;font-weight:700"><a href={'/'+lang+'/nutrition/'+a[0]+'/'}>{lang==='en'?'Read article →':'Leer artículo →'}</a></p></div></div>)}</div></>:<><p class="sample-label">{lang==='en'?'Layout demonstration · Genesis 1 in Latin':'Demostración visual · Génesis 1 en latín'}</p><div class="article-grid">{demoArticles.map(a=><article class="article-card"><div class="article-art"><img src={a.photo} alt="Paisaje ilustrativo de muestra" loading="lazy" /></div><div class="article-body"><div class="heading-share"><h3>{a.title}</h3><details class="inline-share" data-url={'/'+lang+'/'+slug+'/'} data-title={a.title}><summary aria-label="Compartir / Share" title="Compartir / Share">Share</summary><div class="links"><a class="copy" href="#"><span class="social-icon copy-icon" aria-hidden="true">🔗</span>Copy link</a><a class="fb" target="_blank" rel="noopener"><span class="social-icon fb-icon" aria-hidden="true">f</span>Facebook</a><a class="wa" target="_blank" rel="noopener"><span class="social-icon wa-icon" aria-hidden="true">◉</span>WhatsApp</a><a class="mail"><span class="social-icon mail-icon" aria-hidden="true">✉</span>Email</a><a class="pin" target="_blank" rel="noopener"><span class="social-icon pin-icon" aria-hidden="true">p</span>Pinterest</a><a class="tw" target="_blank" rel="noopener"><span class="social-icon tw-icon" aria-hidden="true">𝕏</span>X</a></div></details></div><p class="article-summary">{a.excerpt} {a.body}</p></div></article>)}</div></>}
<p class="article-note">{lang==='en'?'Editorial previews for layout review; not yet medically reviewed for publication.':'Borradores editoriales para revisar el diseño; todavía no cuentan con revisión veterinaria para publicación.'}</p>
<h2>{lang==='en'?'Explore more topics':'Explorar más temas'}</h2><nav class="tiles" aria-label={lang==='en'?'Related topics':'Temas relacionados'}>{Object.entries(t.cats).filter(([k])=>!['about','directory','affiliate-disclosure','privacy','terms',slug].includes(k)).map(([k,v])=><a href={'/'+lang+'/'+k+'/'}>{v}<span aria-hidden="true">→</span></a>)}</nav></section>

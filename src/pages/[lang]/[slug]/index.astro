---
const lang = Astro.params.lang;
const slug = Astro.params.slug;
const dict = {
 en:{home:'Home',back:'Back to bilingual homepage',title:'French Bulldog',desc:'Explore independent guides, practical information and expert-informed resources about French Bulldogs.',cats:{health:'Health guides',nutrition:'Nutrition',training:'Training',puppies:'Puppies','breed-characteristics':'Breed characteristics',history:'History & origins',genetics:'Genetics & breeding','daily-care':'Daily care','news-around-the-world':'News Around the World',store:'BF_STORE',about:'About',directory:'Directory','affiliate-disclosure':'Affiliate disclosure',privacy:'Privacy',terms:'Terms of use'}},
 es:{home:'Inicio',back:'Volver a la portada bilingüe',title:'Bulldog francés',desc:'Explorá guías independientes, información práctica y recursos especializados sobre el bulldog francés.',cats:{health:'Guías de salud',nutrition:'Alimentación',training:'Educación',puppies:'Cachorros','breed-characteristics':'Características de la raza',history:'Historia y orígenes',genetics:'Genética y reproducción','daily-care':'Cuidados cotidianos','news-around-the-world':'Noticias del mundo',store:'BF_STORE',about:'Acerca de',directory:'Directorio','affiliate-disclosure':'Aviso de afiliación',privacy:'Privacidad',terms:'Términos de uso'}}
};

const t=dict[lang];const title=t.cats[slug];
export function getStaticPaths(){
 const langs=['en','es'];const slugs=['health','nutrition','training','puppies','breed-characteristics','history','genetics','daily-care','news-around-the-world','store','about','directory','affiliate-disclosure','privacy','terms'];
 return langs.flatMap(lang=>slugs.map(slug=>({params:{lang,slug}})));
}
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{title} | BulldogFrances.com</title><style>body{margin:0;background:#fff;color:#111;font-family:system-ui}header{padding:20px;display:flex;justify-content:space-between;border-bottom:1px solid #e5e8ec}a{color:inherit}main{width:100%;max-width:none;margin:0;padding:clamp(28px,5vw,72px) clamp(18px,5vw,72px)}h1{font:700 clamp(42px,7vw,90px)/1.05 Georgia,serif}p{font-size:20px;line-height:1.6}.tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.tiles a{padding:20px;border-radius:12px;background:#fbfcff;border:1px solid #e5e8ec;text-decoration:none}@media(max-width:500px){.tiles{grid-template-columns:1fr}}header{background:#fff;padding:16px clamp(18px,5vw,72px)}.tiles{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.tiles a{font-size:19px;padding:26px;border-radius:14px}.tiles a:hover{background:#eef5ff}main>p{max-width:820px}main>h2{margin-top:54px;font:700 clamp(28px,4vw,44px) Georgia,serif}@media(max-width:700px){.tiles{grid-template-columns:1fr 1fr}header{gap:16px}header a{overflow-wrap:anywhere}}@media(max-width:460px){.tiles{grid-template-columns:1fr}}:root{color-scheme:only light}</style></head><body><header><a href="/">BULLDOGFRANCES.COM</a><a href={'/'+(lang==='en'?'es':'en')+'/'+slug+'/'}>{lang==='en'?'Español':'English'}</a></header><main><a href={'/'+lang+'/'}>{lang==='en'?'← English edition':'← Edición en español'}</a><h1>{title}</h1><p>{t.desc}</p><h2>{lang==='en'?'Explore more topics':'Explorar más temas'}</h2><div class="tiles">{Object.entries(t.cats).filter(([k])=>!['about','directory','affiliate-disclosure','privacy','terms'].includes(k)).map(([k,v])=><a href={'/'+lang+'/'+k+'/'}>{v} →</a>)}</div></main></body></html>
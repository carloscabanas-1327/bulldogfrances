---
export function getStaticPaths(){return [{params:{lang:'es'}},{params:{lang:'en'}}]}
const lang=Astro.params.lang;
const es=lang==='es';
const entries=[{"path":"health","en":"Health","es":"Salud","type":"category"},{"path":"nutrition","en":"Nutrition","es":"Alimentación","type":"category"},{"path":"training","en":"Training and behavior","es":"Educación y conducta","type":"category"},{"path":"puppies","en":"Puppies","es":"Cachorros","type":"category"},{"path":"breed-characteristics","en":"Breed characteristics","es":"Características de la raza","type":"category"},{"path":"history","en":"History and origins","es":"Historia y orígenes","type":"category"},{"path":"genetics","en":"Genetics and breeding","es":"Genética y reproducción","type":"category"},{"path":"daily-care","en":"Daily care","es":"Cuidados cotidianos","type":"category"},{"path":"news-around-the-world","en":"News around the world","es":"Noticias del mundo","type":"category"},{"path":"store","en":"Where to buy","es":"Dónde comprar","type":"category"},{"path":"nutrition/how-much-should-a-french-bulldog-eat","en":"How Much Should a French Bulldog Eat?","es":"¿Cuánto debe comer un bulldog francés?","descEn":"Feeding portions, ideal weight, activity and calories","descEs":"Raciones, peso ideal, actividad y calorías","type":"article"},{"path":"nutrition/best-food-for-french-bulldogs","en":"Choosing Food for a French Bulldog","es":"Cómo elegir alimento para un bulldog francés","descEn":"Complete diets, food labels and nutritional quality","descEs":"Dietas completas, etiquetas y calidad nutricional","type":"article"},{"path":"nutrition/french-bulldog-food-allergies","en":"Food Allergies in French Bulldogs","es":"Alergias alimentarias en el bulldog francés","descEn":"Food allergies, itching and veterinary diagnosis","descEs":"Alergias, picazón y diagnóstico veterinario","type":"article"},{"path":"nutrition/safe-treats-for-french-bulldogs","en":"Safe Treats and Foods to Avoid","es":"Premios seguros y alimentos que deben evitarse","descEn":"Treats, toxic foods and choking prevention","descEs":"Premios, alimentos tóxicos y prevención de atragantamiento","type":"article"}];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,follow"/><meta name="color-scheme" content="light"/><title>{es?'Buscar':'Search'} | BulldogFrances.com</title>
<style>
:root{color-scheme:light;font-family:Arial,Helvetica,sans-serif;color:#263243;background:#fff}*{box-sizing:border-box}body{margin:0;overflow-x:hidden}a{color:inherit}header{padding:19px clamp(16px,5vw,65px);border-bottom:1px solid #e4e8ef;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}header a{font-weight:700;text-decoration:none}main{max-width:950px;margin:auto;padding:32px 20px 80px}h1{font:700 clamp(30px,5vw,48px)/1.15 Georgia,serif;margin:0 0 18px}.search{display:flex;gap:8px;max-width:100%;margin-bottom:25px}.search input{min-width:0;flex:1;padding:14px;border:1px solid #bfc8d4;border-radius:10px;font-size:17px}.search button{background:#253b52;color:white;border:0;border-radius:10px;padding:12px 19px;font-size:16px;cursor:pointer}.result{padding:18px 0;border-bottom:1px solid #e3e8ef}.result a{font:700 23px/1.25 Georgia,serif}.result p{margin:8px 0 0;color:#526074;line-height:1.5}.kind{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#687a90;font-weight:700}.status{color:#526074}footer{border-top:1px solid #e3e8ef;text-align:center;padding:24px;color:#526074}@media(max-width:520px){header{padding:14px 16px}header a{font-size:15px}.search button{padding:12px}.result a{font-size:21px}}
</style></head><body><header><a href={'/'+lang+'/'}>BULLDOGFRANCES.COM</a><a href={'/'+(es?'en':'es')+'/search/'}>{es?'EN English':'ES Español'}</a></header><main><h1>{es?'Buscar en BulldogFrances.com':'Search BulldogFrances.com'}</h1><form class="search" action={'/'+lang+'/search/'} method="get" role="search"><input id="q" name="q" type="search" placeholder={es?'Buscar artículos y categorías':'Search articles and categories'} aria-label={es?'Buscar':'Search'} autofocus/><button type="submit">{es?'Buscar':'Search'}</button></form><p class="status" id="status" aria-live="polite"></p><div id="results"></div></main><footer><a href={'/'+lang+'/'}>{es?'Inicio':'Home'}</a> · © {new Date().getFullYear()} BulldogFrances.com</footer>
<script define:vars={{entries,lang}}>
const es=lang==='es';const input=document.querySelector('#q');const results=document.querySelector('#results');const status=document.querySelector('#status');const params=new URLSearchParams(location.search);input.value=params.get('q')||'';
const normalize=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
function render(){const q=normalize(input.value);const terms=q.split(/\s+/).filter(Boolean);const found=terms.length?entries.filter(x=>{const hay=normalize([x.en,x.es,x.descEn,x.descEs,x.path].join(' '));return terms.every(t=>hay.includes(t))}):[];results.replaceChildren();status.textContent=!q?(es?'Escribí una palabra para buscar.':'Enter a word to search.'):found.length?(es?found.length+' resultados':'Results: '+found.length):(es?'No encontramos coincidencias en el contenido registrado.':'No matches in the registered content.');for(const x of found){const item=document.createElement('article');item.className='result';const kind=document.createElement('div');kind.className='kind';kind.textContent=x.type==='article'?(es?'Artículo':'Article'):(es?'Categoría':'Category');const a=document.createElement('a');a.href='/'+lang+'/'+x.path+'/';a.textContent=es?x.es:x.en;const p=document.createElement('p');p.textContent=es?(x.descEs||''):(x.descEn||'');item.append(kind,a,p);results.append(item)}}
input.addEventListener('input',render);render();
</script></body></html>
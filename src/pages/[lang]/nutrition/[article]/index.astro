const articles=[{"slug":"how-much-should-a-french-bulldog-eat","en":"How Much Should a French Bulldog Eat?","es":"¿Cuánto debe comer un bulldog francés?","image":"https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=1200&h=800&fit=crop&auto=format&q=85","esSections":[["La cantidad depende del perro","No existe una ración universal. Las necesidades energéticas cambian según el peso ideal, la edad, la actividad, la esterilización y el estado de salud. La tabla del alimento es un punto de partida, no una prescripción."],["Cómo ajustar la ración","Pesá la comida con una balanza de cocina, registrá los premios y observá la condición corporal cada dos o cuatro semanas. Deben poder palparse las costillas sin una capa excesiva de grasa y apreciarse la cintura vista desde arriba."],["Cuándo consultar","Si tu perro aumenta o pierde peso sin explicación, tiene hambre excesiva, vómitos o diarrea persistente, consultá al veterinario. En cachorros y perros enfermos no conviene improvisar restricciones calóricas."]],"enSections":[["There is no universal portion","Energy needs depend on ideal body weight, age, activity, neuter status and health. The feeding guide on the package is a starting point, not an individualized prescription."],["Adjust using body condition","Weigh food with a kitchen scale, account for treats and check body condition every two to four weeks. You should be able to feel the ribs without excessive fat and see a waist from above."],["When to call your veterinarian","Unexplained weight changes, excessive hunger, persistent vomiting or diarrhea warrant veterinary advice. Do not improvise calorie restriction for puppies or dogs with medical conditions."]]},{"slug":"best-food-for-french-bulldogs","en":"Choosing Food for a French Bulldog","es":"Cómo elegir alimento para un bulldog francés","image":"https://images.unsplash.com/photo-1582798358481-d199fb7347bb?w=1200&h=800&fit=crop&auto=format&q=85","esSections":[["Primero, una dieta completa","Buscá un alimento completo y equilibrado para la etapa de vida correspondiente. La idoneidad nutricional y el control de calidad importan más que las palabras publicitarias del envase."],["Qué conviene preguntar","Investigá si la empresa cuenta con profesionales especializados en nutrición animal, controles de calidad, información sobre formulación y atención al consumidor. Considerá la tolerancia digestiva y el peso del perro."],["No hay un ingrediente mágico","Sin cereales, natural o premium no significa automáticamente más saludable. Las dietas caseras necesitan formulación individual por un veterinario especializado en nutrición."]],"enSections":[["Start with complete nutrition","Choose a complete and balanced food appropriate for the dog's life stage. Nutritional adequacy and quality control matter more than marketing language on the label."],["Questions worth asking","Look for qualified nutrition professionals, quality-control practices, formulation information and accessible customer support. Consider digestive tolerance and body condition."],["No magic ingredient","Grain-free, natural and premium do not automatically mean healthier. Home-prepared diets require individualized formulation by a veterinary nutrition specialist."]]},{"slug":"french-bulldog-food-allergies","en":"Food Allergies in French Bulldogs: What to Know","es":"Alergias alimentarias en el bulldog francés","image":"https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=1200&h=800&fit=crop&auto=format&q=85","esSections":[["No toda picazón es alergia alimentaria","Los problemas de piel también pueden deberse a pulgas, infecciones o alergias ambientales. Los síntomas por sí solos no identifican qué alimento sería responsable."],["Cómo se investiga","Cuando corresponde, el veterinario puede indicar una dieta de eliminación estricta con un alimento hidrolizado o una proteína cuidadosamente seleccionada, seguida de una prueba de provocación supervisada."],["Evitá los cambios al azar","Rotar marcas constantemente puede dificultar el diagnóstico. Durante una prueba de eliminación, premios, sobras y medicamentos saborizados pueden invalidar los resultados."]],"enSections":[["Itching is not always a food allergy","Skin problems can also involve fleas, infections or environmental allergies. Symptoms alone cannot identify a responsible food ingredient."],["How diagnosis works","A veterinarian may recommend a strict elimination diet using a hydrolyzed or carefully selected protein, followed by a supervised food challenge."],["Avoid random food switches","Constantly changing brands can complicate diagnosis. Treats, table scraps and flavored medications may interfere with an elimination trial."]]},{"slug":"safe-treats-for-french-bulldogs","en":"Safe Treats and Foods to Avoid","es":"Premios seguros y alimentos que deben evitarse","image":"https://images.unsplash.com/photo-1601758228041-f3b2795255f1?w=1200&h=800&fit=crop&auto=format&q=85","esSections":[["Los premios también cuentan","Como orientación general, los premios no deberían superar el 10 % de las calorías diarias. Elegí bocados pequeños, adecuados al tamaño del perro, y descontalos de la ración total."],["Alimentos peligrosos","Nunca ofrezcas chocolate, uvas, pasas, cebolla, ajo ni productos con xilitol. Los huesos cocidos también pueden causar lesiones y obstrucciones."],["Seguridad al comer","Supervisá los premios masticables y evitá piezas que puedan provocar atragantamiento. Si sospechás ingestión de un tóxico, contactá inmediatamente a un veterinario; no provoques el vómito sin indicación profesional."]],"enSections":[["Treats count toward calories","As a general guideline, treats should make up no more than 10% of daily calories. Choose small, appropriately sized pieces and account for them in the daily ration."],["Dangerous foods","Never offer chocolate, grapes, raisins, onion, garlic or xylitol-containing products. Cooked bones can also cause injury or obstruction."],["Safe snacking","Supervise chews and avoid choking hazards. If you suspect poisoning, contact a veterinarian immediately; do not induce vomiting without professional advice."]]}];
export function getStaticPaths(){const slugs=["how-much-should-a-french-bulldog-eat","best-food-for-french-bulldogs","french-bulldog-food-allergies","safe-treats-for-french-bulldogs"];return ['es','en'].flatMap(lang=>slugs.map(article=>({params:{lang,article}})))}
const lang=Astro.params.lang;const en=lang==='en';const a=articles.find(x=>x.slug===Astro.params.article);const sections=en?a.enSections:a.esSections;
const related=articles.filter(x=>x.slug!==a.slug);

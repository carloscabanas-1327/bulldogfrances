---
const lang = Astro.params.lang;
export function getStaticPaths(){return [{params:{lang:'en'}},{params:{lang:'es'}}]}
const en=lang==='en';
const sections=[
{slug:'health',en:'Health',es:'Salud',descEn:'Breathing, preventive care and wellbeing.',descEs:'Respiración, prevención y bienestar.',icon:'♡',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'nutrition',en:'Nutrition',es:'Alimentación',descEn:'Evidence-based feeding and nutrition.',descEs:'Alimentación basada en evidencia.',icon:'◉',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'training',en:'Training',es:'Educación',descEn:'Behavior, learning and everyday life.',descEs:'Conducta, aprendizaje y convivencia.',icon:'✦',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'puppies',en:'Puppies',es:'Cachorros',descEn:'Responsible puppy care and development.',descEs:'Cuidados responsables y desarrollo.',icon:'♙',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'breed-characteristics',en:'Breed Characteristics',es:'Características de la raza',descEn:'Appearance and temperament.',descEs:'Aspecto y temperamento.',icon:'♧',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'history',en:'History & Origins',es:'Historia y orígenes',descEn:'Origins and development.',descEs:'Orígenes y evolución.',icon:'▤',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'genetics',en:'Genetics & Breeding',es:'Genética y reproducción',descEn:'Genetics and responsible breeding.',descEs:'Genética y cría responsable.',icon:'⌘',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'daily-care',en:'Daily Care',es:'Cuidados cotidianos',descEn:'Grooming and everyday routines.',descEs:'Higiene y rutinas.',icon:'⌂',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'news-around-the-world',en:'News Around the World',es:'Noticias del mundo',descEn:'French Bulldog news, research and developments worldwide.',descEs:'Noticias, investigaciones y novedades de la raza en todo el mundo.',icon:'◎',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'store',en:'Where to Buy',es:'Dónde comprar',descEn:'Shopping guides, food and accessories.',descEs:'Guías de compra, alimentos y accesorios.',icon:'▣',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'}
];
const base='/'+lang+'/';
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow"><meta name="color-scheme" content="light">
<title>{en?'French Bulldog — English edition':'Bulldog francés — Edición en español'} | BulldogFrances.com</title>
<meta name="description" content={en?'French Bulldog health, nutrition, behavior and everyday care guides.':'Guías sobre salud, alimentación, educación y cuidados del bulldog francés.'}>
<style is:global>
:root{font-family:Arial,Helvetica,sans-serif;color:#192b3b;background:#fff;color-scheme:light}*,*::before,*::after{box-sizing:border-box}html{min-width:320px}body{margin:0;min-width:320px;overflow-x:clip}img,svg{max-width:100%}a{color:inherit}header,main,footer{width:min(100% - 32px,1200px);margin-inline:auto}header{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid #e1e5eb;background:white}header a{text-decoration:none}.logo,.brand{font:700 clamp(18px,2vw,24px)/1.2 Georgia,serif;overflow-wrap:anywhere}.header-inner{width:100%;display:flex;justify-content:space-between;align-items:center;gap:16px}.switch{display:inline-flex;align-items:center;gap:7px;border:1px solid #d6dce4;border-radius:30px;padding:9px 13px;white-space:nowrap;font-size:14px;font-weight:700}.language-flag{width:25px;height:17px;object-fit:cover}main{min-width:0}.hero{background:#f3f7fc;padding:clamp(24px,4vw,52px);border-radius:0 0 14px 14px}.hero-inner{max-width:100%}.kicker,.eyebrow,.sample-label{font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:#52647b;margin:0 0 10px}h1{font:700 clamp(30px,4vw,46px)/1.12 Georgia,serif;margin:0 0 12px;letter-spacing:-.025em}.intro,.hero .desc{font-size:clamp(15px,1.5vw,18px);line-height:1.5;max-width:780px;margin:0}.content{padding:clamp(22px,3vw,40px) clamp(12px,3vw,38px) 65px;min-width:0}footer{border-top:1px solid #e1e5eb;padding:28px 16px;text-align:center;color:#52647b}footer nav{display:flex;flex-wrap:wrap;justify-content:center;gap:12px 20px}footer a{font-size:14px}footer p,footer small{font-size:13px}.copyright{font-size:12px}.grid,.article-grid,.tiles,.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tile,.article-card,.related-card,.tiles a{min-width:0;overflow:hidden;border:1px solid #e1e5eb;border-radius:14px;background:white;text-decoration:none}.tile-photo,.article-art img,.related-card img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}.tile-content,.article-body{display:flex;flex-direction:column;gap:8px;padding:16px}.tile strong,.article-body h3,.related-card strong{font:700 clamp(19px,2vw,24px)/1.2 Georgia,serif}.tile .desc,.article-body p{font-size:15px;line-height:1.5;color:#4e5d6b}.tile .arrow{font-size:14px;font-weight:700}.tile .icon{display:none}.article-body h3,.article-body p{margin:0}.article-art{overflow:hidden}.article-summary{font-size:15px;line-height:1.5}.read-article{display:inline-block;margin-top:10px}.legal-document,.article-text{max-width:780px;margin:0 auto}.legal-section{margin:0 0 28px}.legal-section h2,.article-text h2{font:700 clamp(23px,2.7vw,31px)/1.2 Georgia,serif;margin:0 0 10px}.legal-section p,.article-text p{font-size:16px;line-height:1.7;margin:0 0 15px}.lead-image{width:100%;max-height:470px;aspect-ratio:16/9;object-fit:cover;border-radius:14px;display:block}.article-text{margin-top:28px}.disclaimer{background:#f3f7fc;padding:15px;border-left:3px solid #7390af}.related{border-top:1px solid #e1e5eb;padding-top:25px}.related-card strong,.related-card span{display:block;padding:12px}.related-card span{font-size:14px}.heading-share{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.inline-share{position:relative;flex-shrink:0}.inline-share summary{cursor:pointer}.inline-share .links{position:absolute;right:0;top:100%;z-index:5;min-width:175px;background:white;border:1px solid #ddd;border-radius:10px;padding:10px;box-shadow:0 6px 20px #0002}.inline-share .links a{display:block;padding:6px}.social-icon{display:inline-block;margin-right:6px}.social-icon svg{width:17px;height:17px}.footer-nav{display:flex;flex-wrap:wrap;justify-content:center;gap:12px}.tiles a{padding:14px}.article-note{font-size:13px;color:#607080}@media(max-width:850px){.grid,.article-grid,.tiles,.related-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){header,main,footer{width:calc(100% - 20px)}header{min-height:62px}.hero{padding:24px 18px}.content{padding:22px 10px 45px}.grid,.article-grid,.tiles,.related-grid{grid-template-columns:1fr}.tile-photo{aspect-ratio:16/8}.logo,.brand{font-size:17px}.switch{padding:8px;font-size:12px}.legal-document{max-width:100%}.heading-share{gap:8px}}

/* Match language home header exactly to category and article headers. */
.edition-shell{width:100%;max-width:none;margin:0;padding:0}
.edition-shell>header{width:min(1200px,calc(100% - 32px));max-width:1200px;margin-inline:auto;padding:0;min-height:68px;display:flex;align-items:center}
.edition-shell>header>.header-inner{width:100%;max-width:none;margin:0;padding:0;min-height:68px;display:flex;align-items:center;justify-content:space-between}
.edition-shell>header .logo{font:700 22px/1.2 Georgia,serif;letter-spacing:normal}
.edition-shell>main,.edition-shell>footer{width:min(1200px,calc(100% - 32px));max-width:1200px;margin-inline:auto}
@media(max-width:650px){.edition-shell>header,.edition-shell>main,.edition-shell>footer{width:calc(100% - 20px)}.edition-shell>header .logo{font-size:17px}}

/* Fine alignment: language switch 2px to the right. */
header .switch{transform:translateX(2px)}
</style>
<!-- Redeploy bilingual news and category updates -->
<link rel="stylesheet" href="/search.css"><link rel="stylesheet" href="/site-header.css"></head>
<body>
<div class="edition-shell">
<header><div class="header-inner"><a class="logo" href="/">BULLDOGFRANCES.COM</a><nav aria-label={en?'Language navigation':'Navegación de idioma'}><a class="switch" href={en?'/es/':'/en/'} hreflang={en?'es':'en'}><img class="language-flag" src={en?"/flags/es.svg":"/flags/us.svg"} alt="" width="25" height="17" /> {en?'Español →':'English →'}</a></nav></div></header>
<main>
<section class="hero"><div class="hero-inner"><div class="kicker">{en?'English edition':'Edición en español'}</div><h1>{en?'Everything French Bulldog':'Todo sobre el bulldog francés'}</h1><p class="intro">{en?'Health, nutrition, training and everyday life — useful guides for people who love French Bulldogs.':'Salud, alimentación, educación y vida cotidiana: guías útiles para quienes aman al bulldog francés.'}</p></div></section>
<section class="content"><nav class="grid" aria-label={en?'Topics':'Temas'}>{sections.map(s=><a class="tile" href={base+s.slug+'/'}><img class="tile-photo" src={s.photo} alt={en?`French Bulldog photo illustrating ${s.en}`:`Fotografía de bulldog francés para ${s.es}`} loading="lazy" decoding="async" /><span class="tile-content"><span class="icon" aria-hidden="true">{s.icon}</span><strong>{en?s.en:s.es}</strong><span class="desc">{en?s.descEn:s.descEs}</span><span class="arrow">{en?'Explore section →':'Explorar sección →'}</span></span></a>)}</nav></section>
</main>
<footer><nav><a href={base}>{en?'Home':'Inicio'}</a><a href={base+'about/'}>{en?'About':'Acerca de'}</a><a href={base+'contact/'}>{en?'Contact':'Contacto'}</a><a href={base+'directory/'}>{en?'Directory':'Directorio'}</a><a href={base+'affiliate-disclosure/'}>{en?'Affiliate disclosure':'Aviso de afiliación'}</a><a href={base+'privacy/'}>{en?'Privacy':'Privacidad'}</a><a href={base+'terms/'}>{en?'Terms':'Términos'}</a></nav><p>{en?'Independent editorial guide to French Bulldogs':'Guía editorial independiente sobre el bulldog francés'}</p><p class="copyright">© {new Date().getFullYear()} BulldogFrances.com. All rights reserved.</p></footer>
</div>
<script is:inline>document.querySelectorAll('.inline-share').forEach(d=>{const url=new URL(d.dataset.url||location.pathname,location.origin).href,u=encodeURIComponent(url),t=encodeURIComponent(d.dataset.title||document.title);d.querySelector('.fb').href='https://www.facebook.com/sharer/sharer.php?u='+u;d.querySelector('.wa').href='https://api.whatsapp.com/send?text='+t+'%20'+u;d.querySelector('.mail').href='mailto:?subject='+t+'&body='+u;d.querySelector('.pin').href='https://pinterest.com/pin/create/button/?url='+u+'&description='+t;d.querySelector('.copy').onclick=e=>{e.preventDefault();navigator.clipboard.writeText(url).then(()=>e.target.textContent='Copied').catch(()=>prompt('Copy link',url))}});</script><script is:inline src="/search.js"></script></body></html>
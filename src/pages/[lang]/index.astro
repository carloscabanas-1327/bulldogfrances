---
const lang = Astro.params.lang;
export function getStaticPaths(){return [{params:{lang:'en'}},{params:{lang:'es'}}]}
const en=lang==='en';const items=en?{health:'Health',nutrition:'Nutrition',training:'Training',puppies:'Puppies',directory:'Directory',about:'About'}:{health:'Salud',nutrition:'Alimentación',training:'Educación',puppies:'Cachorros',directory:'Directorio',about:'Acerca de'};
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{en?'English edition':'Edición en español'} | BulldogFrances.com</title><style>body{margin:0;font-family:system-ui;background:#f7f5ef;color:#20372f}header{padding:18px 5%;display:flex;justify-content:space-between}a{color:inherit}main{max-width:1000px;margin:auto;padding:60px 5%}h1{font:clamp(38px,7vw,85px) Georgia,serif}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.grid a{padding:24px;background:#e3e9e1;border-radius:14px;text-decoration:none;font-size:20px}@media(max-width:500px){.grid{grid-template-columns:1fr}}</style></head><body><header><a href="/">BULLDOGFRANCES.COM</a><a href={'/'+(en?'es':'en')+'/'}>{en?'Español':'English'}</a></header><main><h1>{en?'The French Bulldog':'El bulldog francés'}</h1><p>{en?'Explore our editorial sections. Articles are being prepared.':'Explorá nuestras secciones editoriales. Los artículos están en preparación.'}</p><nav class="grid">{Object.entries(items).map(([slug,name])=><a href={'/'+lang+'/'+slug+'/'}>{name} →</a>)}</nav></main></body></html>
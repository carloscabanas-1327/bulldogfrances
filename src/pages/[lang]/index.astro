---
const lang = Astro.params.lang;
export function getStaticPaths(){return [{params:{lang:'en'}},{params:{lang:'es'}}]}
const en=lang==='en';
const sections=[
{slug:'health',en:'Health',es:'Salud',descEn:'Breathing, preventive care and wellbeing.',descEs:'Respiración, prevención y bienestar.',icon:'♡',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'nutrition',en:'Nutrition',es:'Alimentación',descEn:'Evidence-based feeding and nutrition.',descEs:'Alimentación basada en evidencia.',icon:'◉',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'training',en:'Training',es:'Educación',descEn:'Behavior, learning and everyday life.',descEs:'Conducta, aprendizaje y convivencia.',icon:'✦',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'puppies',en:'Puppies',es:'Cachorros',descEn:'Responsible puppy care and development.',descEs:'Cuidados responsables y desarrollo.',icon:'♙',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'breed-characteristics',en:'Breed Characteristics',es:'Características de la raza',descEn:'Appearance and temperament.',descEs:'Aspecto y temperamento.',icon:'♧',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'history',en:'History & Origins',es:'Historia y orígenes',descEn:'Origins and development.',descEs:'Orígenes y evolución.',icon:'▤',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'genetics',en:'Genetics & Breeding',es:'Genética y reproducción',descEn:'Genetics and responsible breeding.',descEs:'Genética y cría responsable.',icon:'⌘',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'daily-care',en:'Daily Care',es:'Cuidados cotidianos',descEn:'Grooming and everyday routines.',descEs:'Higiene y rutinas.',icon:'⌂',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'news-around-the-world',en:'News Around the World',es:'Noticias del mundo',descEn:'French Bulldog news, research and developments worldwide.',descEs:'Noticias, investigaciones y novedades de la raza en todo el mundo.',icon:'◎',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'},
{slug:'store',en:'Where to Buy',es:'Dónde comprar',descEn:'Shopping guides, food and accessories.',descEs:'Guías de compra, alimentos y accesorios.',icon:'▣',photo:'https://images.unsplash.com/photo-1756780773088-483782cfe8ff?w=640&h=460&fit=crop&crop=faces&auto=format&q=82'}
];
const base='/'+lang+'/';
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow"><meta name="color-scheme" content="light">
<title>{en?'French Bulldog — English edition':'Bulldog francés — Edición en español'} | BulldogFrances.com</title>
<meta name="description" content={en?'French Bulldog health, nutrition, behavior and everyday care guides.':'Guías sobre salud, alimentación, educación y cuidados del bulldog francés.'}>
<style>
:root{color-scheme:light;font-family:Arial,Helvetica,sans-serif;background:#faf8f3;color:#20372e}*{box-sizing:border-box}body{margin:0}a{color:inherit}header{background:#fff;border-bottom:1px solid #e4e0d7;padding:16px clamp(16px,4vw,60px);display:flex;align-items:center;justify-content:space-between;gap:16px}header a{text-decoration:none}header .logo{font:700 clamp(17px,2.6vw,25px) Georgia,serif}header nav{display:flex;gap:16px;align-items:center;font-size:clamp(13px,1.5vw,16px)}.switch{padding:10px 14px;border:1px solid #b4c7b8;border-radius:30px;font-weight:700}.hero{background:linear-gradient(135deg,#244b3a,#112f26);color:#fff;padding:clamp(55px,8vw,110px) clamp(18px,7vw,110px)}.hero-inner{max-width:1150px;margin:auto}.kicker{letter-spacing:.16em;text-transform:uppercase;font-size:clamp(12px,1.4vw,15px)}h1{font:700 clamp(43px,7vw,90px)/1.03 Georgia,serif;letter-spacing:-.045em;margin:20px 0}.intro{font-size:clamp(17px,2vw,23px);line-height:1.5;max-width:680px}.note{margin-top:26px;font-size:clamp(13px,1.4vw,16px);opacity:.85}.content{max-width:1200px;margin:auto;padding:45px clamp(16px,4vw,55px) 80px}.content h2{font:700 clamp(29px,3.5vw,43px) Georgia,serif;margin:0 0 22px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.tile{display:flex;flex-direction:column;gap:12px;min-height:210px;padding:28px;background:#fff;border:1px solid #e2e5dc;border-radius:18px;text-decoration:none;box-shadow:0 4px 20px #00000008}.tile:hover,.tile:focus-visible{outline:2px solid #397359}.tile .icon{font-size:35px;color:#33654e}.tile strong{font:700 clamp(23px,3vw,34px) Georgia,serif}.tile .desc{font-size:clamp(15px,1.7vw,18px);line-height:1.45;color:#526158}.tile .arrow{margin-top:auto;font-weight:700;color:#276047}footer{background:#17372b;color:#fff;text-align:center;padding:30px 16px}footer nav{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin:18px 0}footer a{font-size:14px}footer p{font-size:13px;opacity:.85}@media(max-width:620px){header{align-items:flex-start}header .logo{font-size:15px;overflow-wrap:anywhere}header nav{gap:8px}.switch{padding:9px;font-size:13px}.hero{padding:55px 20px}.grid{grid-template-columns:1fr}.tile{min-height:180px;padding:23px}.content{padding-top:35px}footer nav{gap:14px}}

/* Light, accessible edition pages on phones in dark mode and desktop */
:root,html,body{color-scheme:only light!important;background:#fff!important;color:#111!important}
header,header a,header .logo,header nav{background:#fff!important;color:#111!important}
header .switch{border-color:#ddd!important;color:#111!important}
.hero{background:#fbfcff!important;background-image:linear-gradient(#fbfcff,#fbfcff)!important;color:#111!important}
.hero h1,.hero .kicker,.hero .intro,.hero .note{color:#111!important}
.content{background:#fff!important;color:#111!important}
.content h2,.tile,.tile strong,.tile .desc,.tile .arrow,.tile .icon{color:#111!important}
.tile{background:#fff!important;border-color:#e5e5e5!important;box-shadow:none!important}
footer,footer a,footer p{background:#fff!important;color:#111!important}
footer{border-top:1px solid #eee!important}
@media(prefers-color-scheme:dark){
:root,html,body{color-scheme:only light!important;background:#fff!important;color:#111!important}
header,header a,header .logo,header nav{background:#fff!important;color:#111!important}
.hero{background:#fbfcff!important;background-image:linear-gradient(#fbfcff,#fbfcff)!important;color:#111!important}
.hero h1,.hero .kicker,.hero .intro,.hero .note{color:#111!important}
.content,.tile,footer,footer a,footer p{background:#fff!important;color:#111!important}
.content h2,.tile strong,.tile .desc,.tile .arrow,.tile .icon{color:#111!important}
}

/* Photo-led category directory, consistent in both languages */
.content{max-width:1250px!important}
.grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:22px!important}
.tile{padding:0!important;min-height:0!important;overflow:hidden!important;gap:0!important;display:flex!important;flex-direction:column!important;border-radius:16px!important}
.tile-photo{display:block;width:100%;height:205px;object-fit:cover;background:#f0f1ef}
.tile-content{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:22px 24px 25px;flex:1}
.tile .icon{display:none}
.tile strong{font-size:clamp(23px,2.6vw,32px)!important}
.tile .arrow{margin-top:auto;padding-top:8px}
.store-preview{margin-top:55px;display:grid;grid-template-columns:1.4fr 1fr;gap:30px;align-items:center;background:#f7f9fb;border:1px solid #e8eaed;border-radius:18px;overflow:hidden}
.store-preview>div{padding:30px}.store-preview h2{margin:12px 0!important}.store-preview p{font-size:17px;line-height:1.55}.store-preview img{width:100%;height:100%;min-height:230px;object-fit:cover}
.store-label{font-size:12px;letter-spacing:.14em}.store-pending{font-size:13px;color:#666}
@media(max-width:620px){.grid{grid-template-columns:1fr!important}.tile-photo{height:200px}.store-preview{grid-template-columns:1fr}.store-preview img{height:200px;min-height:0;order:-1}.store-preview>div{padding:20px}}

/* Keep opening screen useful on phones */
@media(max-width:620px){
header{padding:12px 14px!important;gap:8px!important}
header .logo{font-size:clamp(14px,4vw,18px)!important;overflow-wrap:anywhere}
header nav{gap:8px!important;font-size:12px!important}
header .switch{padding:7px 9px!important}
.hero{padding-top:0!important;padding-bottom:0!important}
.hero-inner{padding-top:34px!important;padding-bottom:34px!important}
.hero h1{font-size:clamp(40px,11vw,58px)!important;margin:13px 0!important}
.hero .intro{font-size:17px!important;line-height:1.45!important}
.content{padding-top:28px!important}
}

/* Compact magazine-style opening, balanced type and immediate visual content */
.hero{padding:36px clamp(18px,4vw,60px) 32px!important;background:#f5f8fc!important}
.hero-inner{max-width:1240px!important}
.hero .kicker{font:700 12px/1.3 Arial,sans-serif!important;letter-spacing:.12em!important;color:#566476!important}
.hero h1{font:700 clamp(36px,4.4vw,62px)/1.08 Georgia,serif!important;letter-spacing:-.035em!important;margin:12px 0 10px!important;max-width:1000px!important;color:#202532!important}
.hero .intro{font:400 clamp(16px,1.55vw,19px)/1.5 Arial,sans-serif!important;max-width:790px!important;margin:0!important;color:#374151!important}
.content{max-width:1320px!important;padding:30px clamp(18px,4vw,60px) 65px!important}
.content h2{font-size:clamp(25px,2.6vw,35px)!important;margin-bottom:18px!important}
.grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:16px!important}
.tile-photo{height:165px!important}
.tile-content{padding:17px 19px 20px!important;gap:7px!important}
.tile strong{font-size:clamp(21px,2vw,26px)!important}
.tile .desc{font-size:15px!important;line-height:1.4!important}
@media(max-width:800px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:540px){.hero{padding:24px 18px 26px!important}.hero h1{font-size:clamp(32px,9vw,43px)!important}.content{padding:22px 16px 48px!important}.grid{grid-template-columns:1fr!important}.tile-photo{height:185px!important}}

/* Reduce empty vertical space around introduction on all devices */
.hero{padding-top:24px!important;padding-bottom:22px!important}
.hero h1{margin:8px 0!important}
.hero .intro{line-height:1.35!important;margin:0!important}
@media(max-width:620px){.hero{padding-top:20px!important;padding-bottom:20px!important}.hero-inner{padding:0!important}.hero h1{margin:8px 0!important}.hero .intro{font-size:16px!important;line-height:1.35!important}header .logo{overflow-wrap:normal!important;word-break:normal!important;font-size:clamp(12px,3.4vw,17px)!important;letter-spacing:-.025em!important}}
.hero h1{font-size:clamp(32px,3.5vw,46px)!important;margin:7px 0 9px!important}.hero .intro{font-size:clamp(15px,1.35vw,17px)!important}.hero{padding:22px clamp(20px,5vw,72px) 24px!important}@media(max-width:620px){.hero h1{font-size:32px!important}.hero .intro{font-size:15px!important}}
footer .copyright{font-size:13px;opacity:1;margin:22px 0 0;padding-top:18px;border-top:1px solid #e6e8ec;color:#333!important}

/* Shared editorial shell — identical across language and category pages */
:root{color-scheme:only light!important;--ink:#202532;--muted:#4e5969;--edge:#e0e4ea}
body{font-family:Arial,Helvetica,sans-serif!important;font-size:16px!important;line-height:1.5!important}
header{min-height:74px!important;padding:12px clamp(18px,4vw,56px)!important;display:flex!important;align-items:center!important;justify-content:space-between!important;background:#fff!important;color:var(--ink)!important}
header .logo,header .brand{font:700 clamp(17px,2vw,23px)/1.2 Georgia,serif!important;letter-spacing:-.02em!important;white-space:nowrap!important;text-decoration:none!important;color:var(--ink)!important}
header .switch{display:inline-flex!important;align-items:center!important;gap:7px!important;padding:9px 13px!important;border:1px solid #d9dce4!important;border-radius:99px!important;background:#fff!important;color:var(--ink)!important;font:700 14px/1.2 Arial,sans-serif!important;white-space:nowrap!important;text-decoration:none!important}
header .switch .flag{font-size:14px!important;line-height:1!important;display:inline-block!important}
.hero{padding:22px clamp(20px,5vw,72px) 24px!important;background:#f5f8fc!important;color:var(--ink)!important}
.hero h1{font:700 clamp(32px,3.5vw,46px)/1.12 Georgia,serif!important;letter-spacing:-.025em!important;margin:7px 0 9px!important;color:var(--ink)!important}
.hero .intro,.hero .desc{font:400 clamp(15px,1.35vw,17px)/1.42 Arial,sans-serif!important;color:#444c5b!important;margin:0!important;max-width:790px!important}
.hero .kicker,.hero .eyebrow{font:700 12px/1.3 Arial,sans-serif!important;letter-spacing:.12em!important;color:#626b7a!important;text-transform:uppercase!important;margin:0!important}
.content{max-width:1320px!important;margin:auto!important;padding:30px clamp(20px,5vw,72px) 65px!important}
.content h2{font:700 clamp(25px,2.6vw,35px)/1.16 Georgia,serif!important}
footer{background:#fff!important;color:var(--ink)!important;border-top:1px solid var(--edge)!important}
@media(max-width:540px){header{min-height:62px!important;padding:10px 14px!important;gap:8px!important}header .logo,header .brand{font-size:clamp(14px,3.7vw,18px)!important}header .switch{font-size:12px!important;padding:8px 9px!important}.hero{padding:20px 18px 22px!important}.hero h1{font-size:32px!important}.content{padding:24px 16px 48px!important}}
</style>
</head>
<body>
<header><a class="logo" href="/">BULLDOGFRANCES.COM</a><nav aria-label={en?'Language navigation':'Navegación de idioma'}><a class="switch" href={en?'/es/':'/en/'} hreflang={en?'es':'en'}><span aria-hidden="true">{en?'🇪🇸':'🇺🇸'}</span> {en?'Español →':'English →'}</a></nav></header>
<main>
<section class="hero"><div class="hero-inner"><div class="kicker">{en?'English edition':'Edición en español'}</div><h1>{en?'Everything French Bulldog':'Todo sobre el bulldog francés'}</h1><p class="intro">{en?'Health, nutrition, training and everyday life — useful guides for people who love French Bulldogs.':'Salud, alimentación, educación y vida cotidiana: guías útiles para quienes aman al bulldog francés.'}</p></div></section>
<section class="content"><h2>{en?'Explore by topic':'Explorar por temas'}</h2><nav class="grid" aria-label={en?'Topics':'Temas'}>{sections.map(s=><a class="tile" href={base+s.slug+'/'}><img class="tile-photo" src={s.photo} alt={en?`French Bulldog photo illustrating ${s.en}`:`Fotografía de bulldog francés para ${s.es}`} loading="lazy" decoding="async" /><span class="tile-content"><span class="icon" aria-hidden="true">{s.icon}</span><strong>{en?s.en:s.es}</strong><span class="desc">{en?s.descEn:s.descEs}</span><span class="arrow">{en?'Explore section →':'Explorar sección →'}</span></span></a>)}</nav></section>
</main>
<footer><strong>BULLDOGFRANCES.COM</strong><nav><a href={base}>{en?'Home':'Inicio'}</a><a href={base+'about/'}>{en?'About':'Acerca de'}</a><a href={base+'directory/'}>{en?'Directory':'Directorio'}</a><a href={base+'affiliate-disclosure/'}>{en?'Affiliate disclosure':'Aviso de afiliación'}</a><a href={base+'privacy/'}>{en?'Privacy':'Privacidad'}</a><a href={base+'terms/'}>{en?'Terms':'Términos'}</a></nav><p>{en?'Independent editorial guide to French Bulldogs':'Guía editorial independiente sobre el bulldog francés'}</p><p class="copyright">© {new Date().getFullYear()} BulldogFrances.com. All rights reserved.</p></footer>
</body></html>
<header class="top"><div class="mobile-domain">BULLDOGFRANCES.COM</div><a class="brand" href="/en/" aria-label="English — The French Bulldog"><span class="desktop-domain">BULLDOGFRANCES.COM</span><span class="language-name">English →</span><small>THE FRENCH BULLDOG</small></a><a class="brand" href="/es/" aria-label="Español — El Bulldog Francés"><span class="desktop-domain">BULLDOGFRANCES.COM</span><span class="language-name">Español →</span><small>EL BULLDOG FRANCÉS</small></a><div class="dog" aria-hidden="true">🐶</div></header>
<main>
<div class="split hero">
<section class="half en" lang="en"><div class="eyebrow">The French Bulldog</div><h1>Small dog.<br>Big personality.</h1><p>Thoughtful guides and practical information for a healthier, happier French Bulldog.</p><form class="search" action="/en/" method="get"><input aria-label="Search in English" name="q" placeholder="Search guides…" /><button>Search</button></form></section>
<section class="half es" lang="es"><div class="eyebrow">El Bulldog Francés</div><h1>Pequeño perro.<br>Gran carácter.</h1><p>Guías rigurosas e información práctica para cuidar mejor a tu bulldog francés.</p><form class="search" action="/es/" method="get"><input aria-label="Buscar en español" name="q" placeholder="Buscar guías…" /><button>Buscar</button></form></section>
</div>
<div class="split feature-directory">
<div class="feature-column en" lang="en">{sections.map((s,i)=><article class="feature en"><div class="photo" aria-hidden="true">{s.icon}</div><div class="feature-body"><div class="eyebrow">{i===0?'Featured section':'Explore topics'}</div><h2>{s.en}</h2><p>{s.descEn}</p><a href={'/en/'+s.slug+'/'}>Explore section →</a></div></article>)}</div>
<div class="feature-column es" lang="es">{sections.map((s,i)=><article class="feature es"><div class="photo" aria-hidden="true">{s.icon}</div><div class="feature-body"><div class="eyebrow">{i===0?'Sección destacada':'Explorar temas'}</div><h2>{s.es}</h2><p>{s.descEs}</p><a href={'/es/'+s.slug+'/'}>Explorar sección →</a></div></article>)}</div>
</div>
</main>

/* Equal-height bilingual search rows and aligned footer navigation */
.hero{align-items:stretch}
.hero>.half{display:flex!important;flex-direction:column!important;min-width:0}
.hero>.half>.search{margin-top:auto!important;margin-bottom:0!important;flex-shrink:0}
.hero>.half>p{margin-bottom:24px}
footer.split{align-items:stretch}
footer.split>.foot{display:grid;grid-template-rows:auto auto 1fr;align-content:start;min-width:0}
footer.split>.foot nav{align-self:start}
.copyright-bar{width:100%;background:#f7f5f0;color:#3b463f;border-top:1px solid #dcded8;padding:18px 16px;text-align:center;font:13px/1.5 Arial,Helvetica,sans-serif}
@media(max-width:550px){
.hero>.half{padding-bottom:18px!important}
.hero>.half>.search{margin-top:auto!important;margin-bottom:0!important}
footer.split>.foot{padding:20px 12px 22px!important;grid-template-rows: minmax(34px,auto) minmax(42px,auto) 1fr}
footer.split>.foot nav{display:grid!important;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:repeat(6,minmax(30px,auto))!important;align-items:start!important;justify-items:stretch!important;gap:7px!important;width:100%!important;margin:12px 0 0!important;text-align:left!important}
footer.split>.foot nav a{display:block!important;position:relative!important;padding:0 0 0 15px!important;text-align:left!important;line-height:1.35!important;text-decoration:none!important;font-size:clamp(12px,3vw,15px)!important;overflow-wrap:anywhere}
footer.split>.foot nav a::before{content:"●"!important;position:absolute!important;left:0!important;top:.3em!important;color:#000!important;font-size:8px!important;line-height:1!important}
.copyright-bar{font-size:12px;padding:16px 12px}
}

/* 2026 light editorial palette — stable even in dark-mode browsers */
:root{color-scheme:light!important;background:#fff;color:#253a32}
body{background:#fff;color:#253a32}
.hero .half.en,.hero .en{background:#d9e9df!important;color:#203f34!important}
.hero .half.es,.hero .es{background:#f6eadb!important;color:#493629!important}
.hero .half.en h1,.hero .half.en p,.hero .half.en .eyebrow{color:#203f34!important}
.hero .half.es h1,.hero .half.es p,.hero .half.es .eyebrow{color:#493629!important}
.feature-column.en,.feature-column .feature.en{background:#eaf3ed!important;color:#244b3c!important}
.feature-column.es,.feature-column .feature.es{background:#fff5e8!important;color:#59402c!important}

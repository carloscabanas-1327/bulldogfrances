ground:#eee0cd;color:#6e4d31}.topic-copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:4px}.topic-copy strong{font:700 clamp(15px,1.8vw,23px)/1.15 Georgia,serif;overflow-wrap:anywhere}.topic-copy small{font:clamp(11px,1.25vw,15px)/1.35 Arial,sans-serif}.topic-arrow{flex:none;font-size:25px}@media(max-width:550px){.topic-panel{padding:18px 7px 24px}.topic-panel h2{font-size:clamp(17px,4.4vw,23px);margin-bottom:13px}.topic-list{gap:9px}.topic-card{padding:10px 6px;gap:6px;min-height:90px}.topic-icon{width:27px;height:42px;font-size:21px}.topic-copy strong{font:700 clamp(12px,3.2vw,16px)/1.2 Arial,sans-serif}.topic-copy small{font-size:clamp(10px,2.5vw,12px)}.topic-arrow{font-size:18px}}\n.feature-directory{align-items:stretch}.feature-column{min-width:0;display:flex;flex-direction:column}.feature-column.en{background:#e4ece5;color:#18392e}.feature-column.es{background:#f5ede1;color:#3b291c}.feature-column .feature{flex:1;min-width:0;border-bottom:1px solid #00000013;grid-template-columns:minmax(80px,1fr) minmax(0,1.2fr);padding:20px clamp(12px,3vw,45px)}.feature-column .feature .photo{min-width:0;font-size:clamp(45px,6vw,72px)}.feature-column .feature h2,.feature-column .feature p{overflow-wrap:anywhere}@media(max-width:550px){.feature-column .feature{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);align-items:center;gap:7px;padding:12px 7px;min-height:158px}.feature-column .feature .photo{height:90px;font-size:clamp(31px,7vw,46px)}.feature-column .feature h2{text-align:left;font-size:clamp(14px,3.6vw,20px);line-height:1.12}.feature-column .feature .eyebrow{text-align:left;font-size:clamp(9px,2.1vw,11px)}.feature-column .feature p{font-size:clamp(11px,2.6vw,13px);line-height:1.3}.feature-column .feature a{font-size:clamp(11px,2.6vw,13px)}}\n</style>

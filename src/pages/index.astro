---
// Root page: the only bilingual page of the site. It just lets visitors pick a language.
// English home: /en/ (src/pages/en/index.astro). Spanish home: /es/ (src/pages/es/index.astro).
import Seo from '../components/Seo.astro';
import { SITE } from '../data/site.js';
const title = 'BulldogFrances.com | French Bulldog guides · Guías del bulldog francés';
const description = 'Independent French Bulldog guides in English and Spanish. Guías independientes sobre el bulldog francés en inglés y español.';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'BulldogFrances.com',
  url: SITE + '/',
  inLanguage: ['en-US', 'es'],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<title>{title}</title>
<Seo title={title} description={description} lang="en" path="/" alternates={{ en: '/en/', es: '/es/' }} xDefault="/" jsonld={jsonld} />
<link rel="preload" as="image" href="/bulldogfrances-hero.webp" />
<style>
:root{font-family:Arial,Helvetica,sans-serif;color:#1c2b38;background:#fff;color-scheme:light;--ink:#152538;--muted:#566474;--line:#e3e8ee;--soft:#f4f7fb;--accent:#205b86}
*{box-sizing:border-box}
body{margin:0;background:#fff;min-height:100vh;display:flex;flex-direction:column}
a{color:inherit}
.wrap{width:min(1100px,calc(100% - 32px));margin:0 auto}
header{border-bottom:1px solid var(--line)}
header .wrap{display:flex;align-items:center;min-height:68px}
.logo{font:700 clamp(18px,2.2vw,24px)/1.1 Georgia,serif;letter-spacing:-.02em;color:var(--ink)}
main{flex:1;padding:clamp(24px,5vw,56px) 0}
.hero{display:block;width:100%;height:auto;max-height:420px;aspect-ratio:3/2;object-fit:cover;border-radius:clamp(14px,2vw,24px);margin:0 0 clamp(20px,4vw,36px)}
.choices{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.choice{display:flex;flex-direction:column;gap:10px;padding:clamp(20px,3vw,32px);border:1px solid var(--line);border-radius:18px;text-decoration:none;background:#fff;transition:box-shadow .15s,border-color .15s}
.choice:hover,.choice:focus-visible{border-color:#b9c8d6;box-shadow:0 8px 26px #13283c17}
.choice img{width:36px;height:24px;border-radius:3px}
.choice strong{font:700 clamp(26px,3.4vw,38px)/1.1 Georgia,serif;color:var(--ink)}
.choice p{margin:0;color:var(--muted);font-size:17px;line-height:1.5}
.choice span.go{margin-top:6px;font-weight:700;color:var(--accent)}
footer{border-top:1px solid var(--line);padding:22px 0 30px;color:var(--muted);font-size:14px}
@media(max-width:640px){.choices{grid-template-columns:1fr}}
</style>
</head>
<body>
<header><div class="wrap"><span class="logo">BULLDOGFRANCES.COM</span></div></header>
<main class="wrap">
  <img class="hero" src="/bulldogfrances-hero.webp" width="2048" height="1365" alt="" fetchpriority="high" />
  <nav class="choices" aria-label="Choose your language / Elige tu idioma">
    <a class="choice" href="/en/" hreflang="en" lang="en">
      <img src="/flags/us.svg" alt="" width="36" height="24" />
      <strong>Everything French Bulldog</strong>
      <p>Source-based guides on health, puppies, nutrition and everyday care.</p>
      <span class="go">Read in English →</span>
    </a>
    <a class="choice" href="/es/" hreflang="es" lang="es">
      <img src="/flags/es.svg" alt="" width="36" height="24" />
      <strong>Todo sobre el bulldog francés</strong>
      <p>Guías con fuentes sobre salud, cachorros, alimentación y cuidados.</p>
      <span class="go">Leer en español →</span>
    </a>
  </nav>
</main>
<footer><div class="wrap"><small>© {new Date().getFullYear()} BulldogFrances.com</small></div></footer>
</body>
</html>

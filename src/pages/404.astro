---
import Seo from '../components/Seo.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Page not found | BulldogFrances.com</title><Seo title="Page not found | BulldogFrances.com" lang="en" path="/404/" noindex={true} /><style>body{margin:0;font-family:Arial,Helvetica,sans-serif;color:#1c2b38;background:#fff}main{width:min(760px,calc(100% - 32px));margin:12vh auto;text-align:center}h1{font:700 clamp(30px,5vw,46px)/1.15 Georgia,serif;margin:0 0 12px}p{color:#566474;line-height:1.6}a{color:#205b86;font-weight:700}.es{margin-top:34px;padding-top:24px;border-top:1px solid #e3e8ee}</style></head><body><main><div id="nf-en"><h1>Page not found</h1><p>The page you were looking for doesn't exist or has moved.</p><p><a href="/">Go to the homepage</a> · <a href="/en/directory/">See all guides</a></p></div><div id="nf-es" lang="es" hidden><h1>Página no encontrada</h1><p>La página que buscas no existe o cambió de dirección.</p><p><a href="/es/">Ir a la portada</a> · <a href="/es/directory/">Ver todas las guías</a></p></div></main>
<script is:inline>/* Cloudflare serves this page for every missing URL: show only the language of the requested path. */if(location.pathname.startsWith('/es/')){document.documentElement.lang='es';document.title='Página no encontrada | BulldogFrances.com';document.getElementById('nf-en').hidden=true;document.getElementById('nf-es').hidden=false;}</script></body></html>

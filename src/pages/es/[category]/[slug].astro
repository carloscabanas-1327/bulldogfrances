---
// Spanish-edition guide page. Content: editorial/es/guias/<slug>/.
import Seo from '../../../components/Seo.astro';
import {SITE} from '../../../data/site.js';
import {esGuides,esGuideUrl,esGuideHtml,esCategoryLabels} from '../../../data/spanishGuides.js';
import {nutritionArticles} from '../../../data/frenchBulldogGuides.js';
export function getStaticPaths(){return esGuides.map(g=>({params:{category:g.category,slug:g.slug},props:{guide:g}}))}
const {guide}=Astro.props;
const html=esGuideHtml(guide).replace(/<!--[\s\S]*?-->/g,'').replace(/<article\b[^>]*>/i,'').replace(/<\/article>/i,'');
const path=esGuideUrl(guide);
const catLabel=esCategoryLabels[guide.category];
const catPath='/es/'+guide.category+'/';
const faq=guide.faq||[];
const reviewed=guide.lastReviewed||null;
const reviewedLabel=reviewed?new Date(reviewed+'T12:00:00Z').toLocaleDateString('es',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}):'';
const related=[
  ...esGuides.filter(g=>g.category===guide.category&&g.slug!==guide.slug),
  ...esGuides.filter(g=>g.category!==guide.category&&(guide.related||[]).includes(g.slug))
].slice(0,5);
const nutritionRelated=guide.category==='nutrition'?nutritionArticles.map(a=>({url:'/es/nutrition/'+a.slug+'/',title:a.es})):[];
const articleJsonld = {
  '@type':'Article',
  '@id': SITE + path + '#article',
  headline: guide.title,
  description: guide.description,
  inLanguage: 'es',
  url: SITE + path,
  mainEntityOfPage: {'@type':'WebPage','@id':SITE + path},
  ...(guide.image ? {image:[guide.image.startsWith('http') ? guide.image : SITE + guide.image]} : {}),
  ...(guide.primaryKeyword ? {keywords:[guide.primaryKeyword,...(guide.secondaryKeywords||[])].join(', ')} : {}),
  ...(reviewed ? {dateModified:reviewed} : {}),
  author: {'@type':'Organization',name:'BulldogFrances.com',url:SITE + '/'},
  publisher: {'@type':'Organization',name:'BulldogFrances.com',url:SITE + '/'}
};
const jsonld = {'@context':'https://schema.org','@graph':[
  articleJsonld,
  {'@type':'BreadcrumbList','@id':SITE + path + '#breadcrumbs',itemListElement:[
    {'@type':'ListItem',position:1,name:'Inicio',item:SITE + '/es/'},
    {'@type':'ListItem',position:2,name:catLabel,item:SITE + catPath},
    {'@type':'ListItem',position:3,name:guide.title,item:SITE + path}
  ]}
]};
---
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{(guide.seoTitle||guide.title)} | BulldogFrances.com</title><Seo image={guide.image} title={guide.seoTitle||guide.title} description={guide.description} lang="es" path={path} type="article" jsonld={jsonld} alternates={guide.enUrl?{en:guide.enUrl,es:path}:{}} /><style is:global>body{margin:0;background:#f7f9fb;color:#1b2937;font:16px/1.75 Arial,sans-serif}header,main,footer{max-width:1000px;margin:auto;padding:20px}header{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;border-bottom:1px solid #ddd;background:white}header>a{font:700 20px Georgia,serif;text-decoration:none;color:#152538}a{color:#205b86}h1,h2,h3{font-family:Georgia,serif;line-height:1.3}h1{font-size:clamp(28px,4vw,42px)}h2{margin-top:35px}main{box-sizing:border-box;background:white;border-radius:12px;margin-top:18px;padding:clamp(20px,4vw,42px)}.crumbs{font-size:14px;color:#586879}.notice{background:#fff6de;border-left:4px solid #bb8e32;border-radius:5px;padding:12px 16px}.article-body{overflow-wrap:anywhere}.article-body p,.article-body li{max-width:75ch}.article-body nav{background:#f2f6f9;padding:18px;border-radius:10px}.related{border-top:1px solid #ddd;margin-top:36px;padding-top:18px}.related a{display:block;padding:5px 0}footer{border-top:1px solid #ddd;margin-top:24px}.article-body .key-takeaways{background:#eef5fb;border:1px solid #cfe0ee;border-radius:12px;padding:16px 22px;margin:24px 0}.article-body .key-takeaways h2{margin-top:0}.article-body table{width:100%;border-collapse:collapse;margin:22px 0;font-size:15px;display:block;overflow-x:auto}.article-body th,.article-body td{border:1px solid #d6dee6;padding:9px 12px;text-align:left;vertical-align:top}.article-body th{background:#f2f6f9}.article-body ol.references{font-size:14px;color:#3d4b59;padding-left:22px}.article-body ol.references li{margin-bottom:6px}.article-body sup a{text-decoration:none;font-weight:700}.faq details{border:1px solid #dfe6ee;border-radius:10px;padding:10px 16px;margin:10px 0;max-width:75ch}.faq summary{font-weight:700;cursor:pointer}.faq p{margin:8px 0 2px}</style><link rel="stylesheet" href="/article.css"></head><body><header><a href="/es/">BULLDOGFRANCES.COM</a><nav><a href="/es/">Inicio</a> · <a href={catPath}>{catLabel}</a> · <a href={guide.enUrl||'/en/'+guide.category+'/'} hreflang="en" lang="en">English</a></nav></header><main><p class="crumbs"><a href="/es/">Inicio</a> / <a href={catPath}>{catLabel}</a> / {guide.title}</p><h1>{guide.title}</h1>{reviewed && <p class="crumbs">Última revisión: <time datetime={reviewed}>{reviewedLabel}</time></p>}<p class="notice">Fuentes verificadas{reviewed?' el '+reviewedLabel:''}. Esta guía todavía no fue revisada por un veterinario y no reemplaza una consulta veterinaria.</p><div class="article-body" set:html={html}/>{faq.length>0 && <section class="faq"><h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>{faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>}{(related.length>0||nutritionRelated.length>0) && <aside class="related"><h2>También te puede interesar</h2>{related.map(g=><a href={esGuideUrl(g)}>{g.title}</a>)}{nutritionRelated.map(a=><a href={a.url}>{a.title}</a>)}</aside>}</main><footer><a href={catPath}>← Volver a {catLabel}</a> · © {new Date().getFullYear()} BulldogFrances.com</footer></body></html>

---
import {readFileSync} from 'node:fs';
import {join} from 'node:path';
import {guides,categories,guideTitle,guideUrl} from '../../../data/frenchBulldogGuides.js';
export function getStaticPaths(){return guides.map(a=>({params:{category:a.category,slug:a.folder},props:{article:a,html:readFileSync(join(process.cwd(),'editorial/importados-mypetsfamily/french-bulldog-owner-questions-20261028',a.folder,'ARTICLE.html'),'utf8')}}))}
const {article,html}=Astro.props;
const title=guideTitle(article.folder);
const category=categories.find(c=>c.slug===article.category);
const cleanHtml=html.replace(/<!--[\s\S]*?-->/g,'').replace(/<article\b[^>]*>/i,'').replace(/<\/article>/i,'').replace(/<li[^>]*data-mpf-related-slug="([^"]+)"[^>]*>[\s\S]*?<\/li>/g,(_,slug)=>{const target=guides.find(a=>a.folder===slug);return target?'<li><a href="'+guideUrl(target)+'">'+guideTitle(slug)+'</a></li>':''});
const related=guides.filter(a=>a.category===article.category&&a.folder!==article.folder).slice(0,4);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{title} | BulldogFrances.com</title><meta name="description" content={'French Bulldog guide: '+title+'. Editorial review in progress.'}><style>body{margin:0;background:#f7f9fb;color:#1b2937;font:16px/1.75 Arial,sans-serif}header,main,footer{max-width:1000px;margin:auto;padding:20px}header{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;border-bottom:1px solid #ddd;background:white}a{color:#205b86}h1,h2,h3{font-family:Georgia,serif;line-height:1.3}h1{font-size:clamp(28px,4vw,42px)}h2{margin-top:35px}main{box-sizing:border-box;background:white;border-radius:12px;margin-top:18px;padding:clamp(20px,4vw,42px)}.crumbs{font-size:14px;color:#586879}.notice{background:#fff6de;border-left:4px solid #bb8e32;border-radius:5px;padding:12px 16px}.article-body{overflow-wrap:anywhere}.article-body p,.article-body li{max-width:75ch}.article-body nav{background:#f2f6f9;padding:18px;border-radius:10px}.related{border-top:1px solid #ddd;margin-top:36px;padding-top:18px}.related a{display:block;padding:5px 0}footer{border-top:1px solid #ddd;margin-top:24px}</style></head><body><header><a href="/">BULLDOGFRANCES.COM</a><nav><a href="/en/">English home</a> · <a href={'/en/'+article.category+'/'}>{category.label}</a></nav></header><main><p class="crumbs"><a href="/en/">Home</a> / <a href={'/en/'+article.category+'/'}>{category.label}</a> / {title}</p><h1>{title}</h1><p class="notice"><strong>Editorial draft under review.</strong> This guide has not completed veterinary source verification. It is educational content, not an individual diagnosis or treatment plan.</p><div class="article-body" set:html={cleanHtml}/><aside class="related"><h2>More in {category.label}</h2>{related.map(a=><a href={guideUrl(a)}>{guideTitle(a.folder)}</a>)}</aside></main><footer><a href={'/en/'+article.category+'/'}>← Back to {category.label}</a> · © {new Date().getFullYear()} BulldogFrances.com</footer></body></html>
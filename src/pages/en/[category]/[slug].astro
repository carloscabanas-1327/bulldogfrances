---
import {readFileSync} from 'node:fs';
import {join} from 'node:path';
import Seo from '../../../components/Seo.astro';
import {SITE} from '../../../data/site.js';
import {guides,categories,guideTitle,guideUrl,guideSummary,guideHtmlPath,guideMeta} from '../../../data/frenchBulldogGuides.js';
import {enGuides,enGuideUrl,enGuideHtml} from '../../../data/englishGuides.js';
import {esUrlForEn} from '../../../data/spanishGuides.js';
// Two sources: the original owner-question guides and editorial/en/guides.
const all=[
 ...guides.map(a=>({slug:a.folder,category:a.category,title:guideTitle(a.folder),url:guideUrl(a),meta:guideMeta(a.folder),html:()=>readFileSync(join(process.cwd(),guideHtmlPath(a.folder)),'utf8')})),
 ...enGuides.map(g=>({slug:g.slug,category:g.category,title:g.title,url:enGuideUrl(g),meta:g,html:()=>enGuideHtml(g)}))
];
export function getStaticPaths(){
 const list=[
  ...guides.map(a=>({category:a.category,slug:a.folder})),
  ...enGuides.map(g=>({category:g.category,slug:g.slug}))
 ];
 return list.map(x=>({params:x}));
}
const article=all.find(a=>a.slug===Astro.params.slug&&a.category===Astro.params.category);
const html=article.html();
const title=article.title;
const category=categories.find(c=>c.slug===article.category);
const titleOf=slug=>(all.find(a=>a.slug===slug)||{}).title||slug;
const urlOf=slug=>(all.find(a=>a.slug===slug)||{}).url;
const cleanHtml=html.replace(/<!--[\s\S]*?-->/g,'').replace(/<article\b[^>]*>/i,'').replace(/<\/article>/i,'').replace(/<li[^>]*data-mpf-related-slug="([^"]+)"[^>]*>[\s\S]*?<\/li>/g,(_,slug)=>{const u=urlOf(slug);return u?'<li><a href="'+u+'">'+titleOf(slug)+'</a></li>':''});
const meta=article.meta;
const relatedSlugs=meta.related||[];
const related=[...all.filter(a=>relatedSlugs.includes(a.slug)),...all.filter(a=>a.category===article.category&&a.slug!==article.slug&&!relatedSlugs.includes(a.slug))].slice(0,5);
const path=article.url;
const esPath=meta.esUrl||esUrlForEn(path);
const description=meta.description||guideSummary(html);
const faq=meta.faq||[];
const reviewed=meta.lastReviewed||null;
const reviewedLabel=reviewed?new Date(reviewed+'T12:00:00Z').toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}):'';
const jsonld={'@context':'https://schema.org','@graph':[
 {'@type':'Article',headline:title,description,inLanguage:'en-US',mainEntityOfPage:SITE+path,image:SITE+'/og-default.jpg',...(meta.primaryKeyword?{keywords:[meta.primaryKeyword,...(meta.secondaryKeywords||[])].join(', ')}:{}),...(reviewed?{dateModified:reviewed}:{}),publisher:{'@type':'Organization',name:'BulldogFrances.com',url:SITE+'/'}},
 {'@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:SITE+'/en/'},
  {'@type':'ListItem',position:2,name:category.label,item:SITE+'/en/'+category.slug+'/'},
  {'@type':'ListItem',position:3,name:title,item:SITE+path}]},
 ...(faq.length?[{'@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}]:[])]};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{meta.seoTitle||title} | BulldogFrances.com</title><Seo title={meta.seoTitle||title} description={description} lang="en" path={path} type="article" jsonld={jsonld} alternates={esPath?{en:path,es:esPath}:{}} /><style>body{margin:0;background:#f7f9fb;color:#1b2937;font:16px/1.75 Arial,sans-serif}header,main,footer{max-width:1000px;margin:auto;padding:20px}header{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;border-bottom:1px solid #ddd;background:white}header>a{font:700 20px Georgia,serif;text-decoration:none;color:#152538}a{color:#205b86}h1,h2,h3{font-family:Georgia,serif;line-height:1.3}h1{font-size:clamp(28px,4vw,42px)}h2{margin-top:35px}main{box-sizing:border-box;background:white;border-radius:12px;margin-top:18px;padding:clamp(20px,4vw,42px)}.crumbs{font-size:14px;color:#586879}.notice{background:#fff6de;border-left:4px solid #bb8e32;border-radius:5px;padding:12px 16px}.article-body{overflow-wrap:anywhere}.article-body p,.article-body li{max-width:75ch}.article-body nav{background:#f2f6f9;padding:18px;border-radius:10px}.related{border-top:1px solid #ddd;margin-top:36px;padding-top:18px}.related a{display:block;padding:5px 0}footer{border-top:1px solid #ddd;margin-top:24px}.article-body .key-takeaways{background:#eef5fb;border:1px solid #cfe0ee;border-radius:12px;padding:16px 22px;margin:24px 0}.article-body .key-takeaways h2,.article-body .key-takeaways h3{margin-top:0}.article-body table{width:100%;border-collapse:collapse;margin:22px 0;font-size:15px;display:block;overflow-x:auto}.article-body th,.article-body td{border:1px solid #d6dee6;padding:9px 12px;text-align:left;vertical-align:top}.article-body th{background:#f2f6f9}.article-body ol.references{font-size:14px;color:#3d4b59;padding-left:22px}.article-body ol.references li{margin-bottom:6px}.article-body sup a{text-decoration:none;font-weight:700}.faq details{border:1px solid #dfe6ee;border-radius:10px;padding:10px 16px;margin:10px 0;max-width:75ch}.faq summary{font-weight:700;cursor:pointer}.faq p{margin:8px 0 2px}</style></head><body><header><a href="/en/">BULLDOGFRANCES.COM</a><nav><a href="/en/">Home</a> · <a href={'/en/'+article.category+'/'}>{category.label}</a> · <a href={esPath||'/es/'+article.category+'/'} hreflang="es" lang="es">Español</a></nav></header><main><p class="crumbs"><a href="/en/">Home</a> / <a href={'/en/'+article.category+'/'}>{category.label}</a> / {title}</p><h1>{title}</h1>{reviewed && <p class="crumbs">Last reviewed: <time datetime={reviewed}>{reviewedLabel}</time></p>}{meta.status==='REVISED_DRAFT_SOURCED'?<p class="notice">Sources checked{reviewed?' '+reviewedLabel:''}. This guide has not been reviewed by a veterinarian and is not a substitute for veterinary advice.</p>:<p class="notice"><strong>Editorial draft under review.</strong> This guide has not completed veterinary source verification. It is educational content, not an individual diagnosis or treatment plan.</p>}<div class="article-body" set:html={cleanHtml}/>{faq.length>0 && <section class="faq"><h2 id="faq">Frequently asked questions</h2>{faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>}<aside class="related"><h2>More in {category.label}</h2>{related.map(a=><a href={a.url}>{a.title}</a>)}</aside></main><footer><a href={'/en/'+article.category+'/'}>← Back to {category.label}</a> · © {new Date().getFullYear()} BulldogFrances.com</footer></body></html>

---
import {categories,guides,guideTitle,guideUrl} from '../../../data/frenchBulldogGuides.js';
export function getStaticPaths(){return categories.map(category=>({params:{category:category.slug},props:{category}}))}
const {category}=Astro.props;
const articles=guides.filter(a=>a.category===category.slug);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{category.label} | French Bulldog | BulldogFrances.com</title><meta name="description" content={category.description}><style>body{margin:0;background:#fff;color:#192b3b;font:16px/1.6 Arial,sans-serif}header,main,footer{max-width:1200px;margin:auto;padding:22px}header{display:flex;justify-content:space-between;flex-wrap:wrap;border-bottom:1px solid #dfe5ec}a{color:#245578}h1,h2{font-family:Georgia,serif}.breadcrumbs{font-size:14px;color:#627287}.intro{background:#f3f7fc;border-radius:12px;padding:24px;margin:22px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}.card{display:block;text-decoration:none;color:inherit;border:1px solid #e1e5eb;border-radius:12px;padding:22px;background:#fff}.card:hover{box-shadow:0 5px 20px #0001}.card strong{display:block;font-size:19px;line-height:1.4}.card small{color:#617185}footer{margin-top:50px;border-top:1px solid #ddd}.nav{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.nav a{font-size:14px}</style></head><body><header><a href="/">BULLDOGFRANCES.COM</a><nav><a href="/en/">Home</a> · <a href="/es/">Español</a></nav></header><main><p class="breadcrumbs"><a href="/en/">Home</a> / {category.label}</p><section class="intro"><h1>{category.label}</h1><p>{category.description}</p></section><h2>Latest guides</h2><div class="grid">{articles.map(a=><a class="card" href={guideUrl(a)}><strong>{guideTitle(a.folder)}</strong><small>French Bulldog guide · English</small></a>)}</div><nav class="nav" aria-label="Browse other categories">{categories.filter(c=>c.slug!==category.slug).map(c=><a href={'/en/'+c.slug+'/'}>{c.label}</a>)}</nav></main><footer>© {new Date().getFullYear()} BulldogFrances.com · <a href="/en/">Home</a></footer></body></html>
---
import Seo from '../../../components/Seo.astro';
import {categories,guides,guideTitle,guideUrl,nutritionArticles} from '../../../data/frenchBulldogGuides.js';
import {enGuides,enGuideUrl} from '../../../data/englishGuides.js';
export function getStaticPaths(){return categories.map(category=>({params:{category:category.slug},props:{category}}))}
const {category}=Astro.props;
const articles=[...guides.filter(a=>a.category===category.slug).map(a=>({url:guideUrl(a),title:guideTitle(a.folder),note:'French Bulldog guide'})),...enGuides.filter(g=>g.category===category.slug).map(g=>({url:enGuideUrl(g),title:g.title,note:g.description}))].sort((a,b)=>a.title.localeCompare(b.title,'en'));
if(category.slug==='nutrition') articles.unshift(...nutritionArticles.map(a=>({url:'/en/nutrition/'+a.slug+'/',title:a.en,note:a.descEn})));
const path='/en/'+category.slug+'/';
const title=category.label+' | French Bulldog | BulldogFrances.com';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><Seo title={title} description={'French Bulldog '+category.label.toLowerCase()+' guides: '+category.description} lang="en" path={path} alternates={{en:path,es:'/es/'+category.slug+'/'}} /><style>body{margin:0;background:#fff;color:#192b3b;font:16px/1.6 Arial,sans-serif}header,main,footer{max-width:1200px;margin:auto;padding:22px}header{display:flex;justify-content:space-between;flex-wrap:wrap;border-bottom:1px solid #dfe5ec}header>a{font:700 20px Georgia,serif;text-decoration:none;color:#152538}a{color:#245578}h1,h2{font-family:Georgia,serif}.breadcrumbs{font-size:14px;color:#627287}.intro{background:#f3f7fc;border-radius:12px;padding:24px;margin:22px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}.card{display:block;text-decoration:none;color:inherit;border:1px solid #e1e5eb;border-radius:12px;padding:22px;background:#fff}.card:hover{box-shadow:0 5px 20px #0001}.card strong{display:block;font-size:19px;line-height:1.4}.card small{color:#617185}footer{margin-top:50px;border-top:1px solid #ddd}.nav{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.nav a{font-size:14px}</style></head><body><header><a href="/en/">BULLDOGFRANCES.COM</a><nav><a href="/en/">Home</a> · <a href="/en/search/">Search</a> · <a href={'/es/'+category.slug+'/'} hreflang="es" lang="es">Español</a></nav></header><main><p class="breadcrumbs"><a href="/en/">Home</a> / {category.label}</p><section class="intro"><h1>{category.label}</h1><p>{category.description}</p></section><h2>Latest guides</h2><div class="grid">{articles.map(a=><a class="card" href={a.url}><strong>{a.title}</strong><small>{a.note}</small></a>)}</div><nav class="nav" aria-label="Browse other categories">{categories.filter(c=>c.slug!==category.slug).map(c=><a href={'/en/'+c.slug+'/'}>{c.label}</a>)}</nav></main><footer>© {new Date().getFullYear()} BulldogFrances.com · <a href="/en/">Home</a></footer></body></html>
